namespace googlesql {

// Checks that every column reference in a Resolved AST is visible where it
// occurs, according to the column visibility annotations in
// gen_resolved_ast.py. See "ResolvedColumn visibility" in gen_resolved_ast.py
// for the rules.
//
// The checker is generated by gen_resolved_ast_column_visibility.py, which
// turns the annotations on each node class into a Check<NodeName> method.
// The Validator runs it when ValidatorOptions::validate_column_visibility is
// true.
//
// The checker visits the tree top-down. Each node is checked in an Env, which
// holds the column sets that its references can name: the VISIBLE and OUTER
// sets and the named contexts. For each field, the node's Check method
// computes the field's Env from the annotations and recurses into the field
// with it. Fields that don't change anything reuse the node's Env, so an Env
// is only copied when a field changes it, and copying is cheap because an
// Env only holds pointers to column sets.
//
// Column sets only flow down the tree, so a set built for a field is owned by
// the Check method that built it, and is freed when that method returns,
// after the field's subtree has been checked. The exception is when
// `record_environments` is set: then all built sets are owned by the checker
// until the next CheckRoot call, because the recorded environments are read
// after the check.
//
// Recorded environments are for the Validator's comparison mode
// (ValidatorOptions::compare_column_visibility, for tests). With
// `record_environments`, the checker records each node's Env and each scan's
// column_list_scope. The hand-written validator then reads them with
// GetRecordedEnv() and checks that its own `visible_columns`,
// `visible_parameters` and CheckColumnList sets match.
class ColumnVisibilityChecker {
 public:
  using ColumnSet = absl::flat_hash_set<ResolvedColumn>;

  // The environment a node is checked in. Each member points to a column set
  // that is never modified after it is built, and isn't owned by the Env. A
  // null pointer means the empty set, so a default-constructed Env is empty.
  struct Env {
    // The VISIBLE set: columns that non-correlated references may name.
    const ColumnSet* visible = nullptr;
    // The OUTER set: columns that correlated ResolvedColumnRefs may name.
    const ColumnSet* outer = nullptr;
    // The named contexts. See COLUMN_SCOPE_CONTEXT_NAMES in
    // gen_resolved_ast.py.
# for context_name in column_scope_context_names
    const ColumnSet* {{context_name}} = nullptr;
# endfor
  };

  // The environment recorded for a node, when `record_environments` is set.
  // See the class comment.
  struct RecordedEnv {
    Env env;
    // True for scans whose column_list is checked against a
    // `column_list_scope` (scans whose column_list isn't created).
    bool has_column_list_scope = false;
    // The value of `column_list_scope`, if `has_column_list_scope`. Null
    // means the empty set.
    const ColumnSet* column_list_scope = nullptr;
  };

  struct Options {
    // If true, record the environment for each node checked, which can be
    // read with GetRecordedEnv(). See the class comment.
    bool record_environments = false;
  };

  ColumnVisibilityChecker();
  explicit ColumnVisibilityChecker(Options options);
  ColumnVisibilityChecker(const ColumnVisibilityChecker&) = delete;
  ColumnVisibilityChecker& operator=(const ColumnVisibilityChecker&) = delete;

  // Checks `node` (a statement, or a standalone expression) as a root, with
  // empty VISIBLE and OUTER sets. Clears any previously recorded
  // environments.
  //
  // Column visibility check failures
  // --------------------------------
  // A "Column visibility check failed" error names the node and field with
  // the reference, the column, and the set it isn't in. Either the Resolved
  // AST is wrong, or the annotations in gen_resolved_ast.py don't allow a
  // valid reference (see "ResolvedColumn visibility" there). Where to look
  // depends on the reference:
  //   - A ColumnRef: the annotations on the fields above it, which set the
  //     VISIBLE set (or the OUTER set, if it's correlated). For a correlated
  //     reference, check the enclosing subquery's or lambda's parameter_list.
  //   - A scan's column_list: the scan's `column_list_scope` annotation.
  //   - Any other ResolvedColumn field: that field's `scope` annotation.
  absl::Status CheckRoot(const ResolvedNode* node);

  // The node where the last error was detected, or null.
  const ResolvedNode* error_node() const { return error_node_; }

  // Returns the environment recorded for `node`, or null if it wasn't
  // recorded. Requires `record_environments`. The result is valid until the
  // next CheckRoot call.
  const RecordedEnv* GetRecordedEnv(const ResolvedNode* node) const;

  // Returns true if `set` is the special set used for UNCHECKED scopes, which
  // allows any column.
  static bool IsUnchecked(const ColumnSet* set);

 private:
  // Owns column sets built during the check. See the class comment.
  using ColumnSetStorage = std::vector<std::unique_ptr<const ColumnSet>>;

  // Checks `node` in environment `env`, dispatching on the node kind.
  absl::Status CheckNode(const ResolvedNode* node, const Env& env);

  // The generated Check methods, one for each concrete node class.
# for node in nodes
 # if not node.is_abstract
  absl::Status Check{{node.name}}(const {{node.name}}* node, const Env& env);
 # endif
# endfor

  // Checks a referenced ResolvedColumn field against `visible`.
  absl::Status CheckColumn(const ResolvedNode* node, absl::string_view field,
                           const ResolvedColumn& column,
                           const ColumnSet* visible);

  // Checks a ResolvedColumnRef against the VISIBLE or OUTER set, depending on
  // is_correlated.
  absl::Status CheckColumnRef(const ResolvedColumnRef* node, const Env& env);

  // Checks a scan's column_list against its column_list_scope.
  absl::Status CheckColumnList(const ResolvedScan* node,
                               const ColumnSet* scope);

  // Returns the storage for sets built by a Check method: `local`, which the
  // Check method owns, or `recorded_sets_` when recording environments.
  ColumnSetStorage& Storage(ColumnSetStorage& local) {
    return options_.record_environments ? recorded_sets_ : local;
  }

  // Returns the column_list of `scan`'s pipe input scan as a set, or null
  // (the empty set) if it has none. A new set is stored in `owned_sets`.
  static const ColumnSet* GetPipeInputColumns(const ResolvedScan* scan,
                                              ColumnSetStorage& owned_sets);

  absl::Status MakeError(const ResolvedNode* node, absl::string_view field,
                         const ResolvedColumn& column,
                         absl::string_view set_name, const ColumnSet* set);

  const Options options_;
  const ResolvedNode* error_node_ = nullptr;
  absl::flat_hash_map<const ResolvedNode*, RecordedEnv> recorded_envs_;
  // Owns all sets built during a check, when recording environments.
  ColumnSetStorage recorded_sets_;
};

}  // namespace googlesql

#endif  // GOOGLESQL_RESOLVED_AST_RESOLVED_AST_COLUMN_VISIBILITY_CHECKER_H_
