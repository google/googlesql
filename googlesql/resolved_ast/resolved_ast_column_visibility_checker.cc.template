ColumnVisibilityChecker::ColumnVisibilityChecker()
    : ColumnVisibilityChecker(Options()) {}

ColumnVisibilityChecker::ColumnVisibilityChecker(Options options)
    : options_(options) {}

absl::Status ColumnVisibilityChecker::CheckRoot(const ResolvedNode* node) {
  GOOGLESQL_RET_CHECK(node != nullptr);
  error_node_ = nullptr;
  recorded_envs_.clear();
  recorded_sets_.clear();
  return CheckNode(node, Env());
}

const ColumnVisibilityChecker::RecordedEnv*
ColumnVisibilityChecker::GetRecordedEnv(const ResolvedNode* node) const {
  auto it = recorded_envs_.find(node);
  if (it == recorded_envs_.end()) return nullptr;
  return &it->second;
}

const ColumnVisibilityChecker::ColumnSet*
ColumnVisibilityChecker::GetPipeInputColumns(const ResolvedScan* scan,
                                             ColumnSetStorage& owned_sets) {
  const ResolvedScan* input = scan->GetPipeInputScan(/*mark_accessed=*/false);
  if (input == nullptr) return nullptr;
  ColumnSetBuilder b;
  b.Add(input->column_list_untracked());
  return b.Build(owned_sets);
}

absl::Status ColumnVisibilityChecker::MakeError(const ResolvedNode* node,
                                                absl::string_view field,
                                                const ResolvedColumn& column,
                                                absl::string_view set_name,
                                                const ColumnSet* set) {
  error_node_ = node;
  return absl::InternalError(absl::StrCat(
      "Column visibility check failed: ", node->node_kind_string(), ".", field,
      " references column ", column.DebugString(), " which is not in ",
      set_name, " ", ColumnSetToString(set),
      ". See ColumnVisibilityChecker::CheckRoot."));
}

absl::Status ColumnVisibilityChecker::CheckColumn(const ResolvedNode* node,
                                                  absl::string_view field,
                                                  const ResolvedColumn& column,
                                                  const ColumnSet* visible) {
  if (!column.IsInitialized() || Contains(visible, column)) {
    return absl::OkStatus();
  }
  return MakeError(node, field, column, "the VISIBLE columns", visible);
}

absl::Status ColumnVisibilityChecker::CheckColumnRef(
    const ResolvedColumnRef* node, const Env& env) {
  if (node->is_correlated_untracked()) {
    if (Contains(env.outer, node->column_untracked())) return absl::OkStatus();
    return MakeError(node, "column", node->column_untracked(),
                     "the OUTER columns for correlated references", env.outer);
  }
  if (Contains(env.visible, node->column_untracked())) return absl::OkStatus();
  return MakeError(node, "column", node->column_untracked(),
                   "the VISIBLE columns", env.visible);
}

absl::Status ColumnVisibilityChecker::CheckColumnList(const ResolvedScan* node,
                                                      const ColumnSet* scope) {
  if (options_.record_environments) {
    RecordedEnv& recorded = recorded_envs_[node];
    recorded.has_column_list_scope = true;
    recorded.column_list_scope = scope;
  }
  for (const ResolvedColumn& column : node->column_list_untracked()) {
    if (!Contains(scope, column)) {
      return MakeError(node, "column_list", column, "its column_list_scope",
                       scope);
    }
  }
  return absl::OkStatus();
}

