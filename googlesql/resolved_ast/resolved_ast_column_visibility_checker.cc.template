using ColumnSet = ColumnVisibilityChecker::ColumnSet;

// Null means the empty set.
bool Contains(const ColumnSet* set, const ResolvedColumn& column) {
  return set != nullptr && set->contains(column);
}

// Builds the union of some column sets and individual columns. When the
// result is empty, it's null, and when it's exactly one of the input sets,
// that set is reused rather than copied.
class ColumnSetBuilder {
 public:
  void Add(const ColumnSet* set) {
    if (set != nullptr && !set->empty()) {
      sets_.push_back(set);
    }
  }
  void Add(const ResolvedColumn& column) {
    if (column.IsInitialized()) columns_.push_back(column);
  }
  void Add(absl::Span<const ResolvedColumn> columns) {
    for (const ResolvedColumn& column : columns) Add(column);
  }

  // Returns the union of everything added. If that needs a new set, the new
  // set is added to `owned_sets`, which owns it.
  const ColumnSet* Build(
      std::vector<std::unique_ptr<const ColumnSet>>& owned_sets) {
    if (columns_.empty()) {
      if (sets_.empty()) return nullptr;
      if (sets_.size() == 1) return sets_[0];
    }
    auto result = std::make_unique<ColumnSet>(columns_.begin(), columns_.end());
    for (const ColumnSet* set : sets_) {
      result->insert(set->begin(), set->end());
    }
    const ColumnSet* built = result.get();
    owned_sets.push_back(std::move(result));
    return built;
  }

 private:
  std::vector<const ColumnSet*> sets_;
  std::vector<ResolvedColumn> columns_;
};

