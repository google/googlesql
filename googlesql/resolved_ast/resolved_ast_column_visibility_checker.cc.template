std::string ColumnSetToString(const ColumnSet* set) {
  if (set == nullptr) return "[]";
  std::vector<ResolvedColumn> columns(set->begin(), set->end());
  std::sort(columns.begin(), columns.end(),
            [](const ResolvedColumn& a, const ResolvedColumn& b) {
              return a.column_id() < b.column_id();
            });
  constexpr int kMaxColumns = 50;
  std::string result = "[";
  for (int i = 0; i < columns.size() && i < kMaxColumns; ++i) {
    if (i > 0) absl::StrAppend(&result, ", ");
    absl::StrAppend(&result, columns[i].DebugString());
  }
  if (columns.size() > kMaxColumns) {
    absl::StrAppend(&result, ", ... (", columns.size() - kMaxColumns,
                    " more)");
  }
  absl::StrAppend(&result, "]");
  return result;
}

