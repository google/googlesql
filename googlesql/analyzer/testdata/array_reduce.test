# Reducer lambda referencing outer query column
SELECT ARRAY_REDUCE(arr, 0, (acc, e) -> acc + e + x)
FROM (SELECT 10 AS x, [1, 2, 3] AS arr);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#5 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#5]
    +-expr_list=
    | +-$col1#5 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, INT64 initial_value, FUNCTION<(INT64, INT64)->INT64> reducer, optional(1) BOOL ignore_nulls) -> INT64)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-ColumnRef(type=ARRAY<INT64>, column=$subquery1.arr#2)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#3, e#4]
    |     |     +-parameter_list=
    |     |     | +-ColumnRef(type=INT64, column=$subquery1.x#1)
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.acc#3)
    |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.e#4)
    |     |         +-ColumnRef(type=INT64, column=$subquery1.x#1, is_correlated=TRUE)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-ProjectScan
        +-column_list=$subquery1.[x#1, arr#2]
        +-expr_list=
        | +-x#1 := Literal(type=INT64, value=10)
        | +-arr#2 := Literal(type=ARRAY<INT64>, value=[1, 2, 3])
        +-input_scan=
          +-SingleRowScan
==

