# A real world use case:
# Number of local maxima in the given array.
SELECT ARRAY_REDUCE(
  t.signal,
  0,
  (acc, val, idx) -> acc + IF(
    val > t.signal[SAFE_OFFSET(idx - 1)] AND
    val > t.signal[SAFE_OFFSET(idx + 1)],
    1,
    0
  )
) AS local_maxima_count
FROM (SELECT [1, 5, 3, 8, 2, 4, 1] AS signal) t;
--
QueryStmt
+-output_column_list=
| +-$query.local_maxima_count#5 AS local_maxima_count [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.local_maxima_count#5]
    +-expr_list=
    | +-local_maxima_count#5 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, INT64 initial_value, FUNCTION<(INT64, INT64, INT64)->INT64> reducer, optional(1) BOOL ignore_nulls) -> INT64)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-ColumnRef(type=ARRAY<INT64>, column=t.signal#1)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#2, val#3, idx#4]
    |     |     +-parameter_list=
    |     |     | +-ColumnRef(type=ARRAY<INT64>, column=t.signal#1)
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.acc#2)
    |     |         +-FunctionCall(GoogleSQL:if(BOOL, INT64, INT64) -> INT64)
    |     |           +-FunctionCall(GoogleSQL:$and(BOOL, repeated(1) BOOL) -> BOOL)
    |     |           | +-FunctionCall(GoogleSQL:$greater(INT64, INT64) -> BOOL)
    |     |           | | +-ColumnRef(type=INT64, column=$lambda_arg.val#3)
    |     |           | | +-FunctionCall(GoogleSQL:$safe_array_at_offset(ARRAY<INT64>, INT64) -> INT64)
    |     |           | |   +-ColumnRef(type=ARRAY<INT64>, column=t.signal#1, is_correlated=TRUE)
    |     |           | |   +-FunctionCall(GoogleSQL:$subtract(INT64, INT64) -> INT64)
    |     |           | |     +-ColumnRef(type=INT64, column=$lambda_arg.idx#4)
    |     |           | |     +-Literal(type=INT64, value=1)
    |     |           | +-FunctionCall(GoogleSQL:$greater(INT64, INT64) -> BOOL)
    |     |           |   +-ColumnRef(type=INT64, column=$lambda_arg.val#3)
    |     |           |   +-FunctionCall(GoogleSQL:$safe_array_at_offset(ARRAY<INT64>, INT64) -> INT64)
    |     |           |     +-ColumnRef(type=ARRAY<INT64>, column=t.signal#1, is_correlated=TRUE)
    |     |           |     +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |           |       +-ColumnRef(type=INT64, column=$lambda_arg.idx#4)
    |     |           |       +-Literal(type=INT64, value=1)
    |     |           +-Literal(type=INT64, value=1)
    |     |           +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-ProjectScan
        +-column_list=[t.signal#1]
        +-expr_list=
        | +-signal#1 := Literal(type=ARRAY<INT64>, value=[1, 5, 3, 8, 2, 4, 1])
        +-input_scan=
          +-SingleRowScan
