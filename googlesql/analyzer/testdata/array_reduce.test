# ARRAY_REDUCE works when FEATURE_NAMED_ARGUMENTS is disabled if no named arguments are used
[language_features=NONE,+INLINE_LAMBDA_ARGUMENT,+ARRAY_REDUCE]
[no_run_sqlbuilder]
SELECT ARRAY_REDUCE([1, 2, 3], 0, (acc, e) -> acc + e);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#3 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#3]
    +-expr_list=
    | +-$col1#3 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, INT64 initial_value, FUNCTION<(INT64, INT64)->INT64> reducer, optional(1) BOOL ignore_nulls) -> INT64)
    |     +-FunctionArgument
    |     | +-expr=
