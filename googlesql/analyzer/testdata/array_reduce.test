    |     |     +-argument_list=$lambda_arg.[acc#1, e#2]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         +-FunctionCall(GoogleSQL:ifnull(INT64, INT64) -> INT64)
    |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.acc#1)
    |     |         | +-Literal(type=INT64, value=0)
    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.e#2)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

