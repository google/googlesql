# When FEATURE_ARRAY_REDUCE is not enabled, ARRAY_REDUCE is not found.
[default language_features=NONE,+INLINE_LAMBDA_ARGUMENT]
SELECT ARRAY_REDUCE([1, 2, 3], 0, (acc, e) -> acc + e);
--
ERROR: Function not found: ARRAY_REDUCE; Did you mean array_reverse? [at 1:8]
SELECT ARRAY_REDUCE([1, 2, 3], 0, (acc, e) -> acc + e);
       ^
==

[default language_features=NONE,+INLINE_LAMBDA_ARGUMENT,+ARRAY_REDUCE,+NAMED_ARGUMENTS]

# Basic 2-argument lambda reduction
SELECT ARRAY_REDUCE([1, 2, 3], 0, (acc, e) -> acc + e);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#3 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#3]
    +-expr_list=
    | +-$col1#3 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, INT64 initial_value, FUNCTION<(INT64, INT64)->INT64> reducer, optional(1) BOOL ignore_nulls) -> INT64)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<INT64>, value=[1, 2, 3])
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, e#2]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.acc#1)
    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.e#2)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

# 3-argument lambda reduction with index
SELECT ARRAY_REDUCE([1, 2, 3], 0, (acc, e, i) -> acc + e + i);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#4 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#4]
    +-expr_list=
    | +-$col1#4 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, INT64 initial_value, FUNCTION<(INT64, INT64, INT64)->INT64> reducer, optional(1) BOOL ignore_nulls) -> INT64)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<INT64>, value=[1, 2, 3])
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, e#2, i#3]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.acc#1)
    |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.e#2)
    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.i#3)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

# Reduction with different accumulator type
SELECT ARRAY_REDUCE([1, 2, 3], '', (acc, e) -> CONCAT(acc, CAST(e AS STRING)));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#3 AS `$col1` [STRING]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#3]
    +-expr_list=
    | +-$col1#3 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, STRING initial_value, FUNCTION<(STRING, INT64)->STRING> reducer, optional(1) BOOL ignore_nulls) -> STRING)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<INT64>, value=[1, 2, 3])
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=STRING, value="")
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, e#2]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:concat(STRING, repeated(1) STRING) -> STRING)
    |     |         +-ColumnRef(type=STRING, column=$lambda_arg.acc#1)
    |     |         +-Cast(INT64 -> STRING)
    |     |           +-ColumnRef(type=INT64, column=$lambda_arg.e#2)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

# Reduction with STRUCT accumulator
SELECT ARRAY_REDUCE([1, 2, 3], STRUCT(0 AS s, 0 AS c), (acc, e) -> STRUCT(acc.s + e, acc.c + 1));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#3 AS `$col1` [STRUCT<s INT64, c INT64>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#3]
    +-expr_list=
    | +-$col1#3 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, STRUCT<s INT64, c INT64> initial_value, FUNCTION<(STRUCT<s INT64, c INT64>, INT64)->STRUCT<s INT64, c INT64>> reducer, optional(1) BOOL ignore_nulls) -> STRUCT<s INT64, c INT64>)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<INT64>, value=[1, 2, 3])
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=STRUCT<s INT64, c INT64>, value={s:0, c:0})
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, e#2]
    |     |     +-body=
    |     |       +-MakeStruct
    |     |         +-type=STRUCT<s INT64, c INT64>
    |     |         +-field_list=
    |     |           +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |           | +-GetStructField
    |     |           | | +-type=INT64
    |     |           | | +-expr=
    |     |           | | | +-ColumnRef(type=STRUCT<s INT64, c INT64>, column=$lambda_arg.acc#1)
    |     |           | | +-field_idx=0
    |     |           | +-ColumnRef(type=INT64, column=$lambda_arg.e#2)
    |     |           +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |             +-GetStructField
    |     |             | +-type=INT64
    |     |             | +-expr=
    |     |             | | +-ColumnRef(type=STRUCT<s INT64, c INT64>, column=$lambda_arg.acc#1)
    |     |             | +-field_idx=1
    |     |             +-Literal(type=INT64, value=1)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

# Reduction with ARRAY accumulator
SELECT ARRAY_REDUCE([1, 2, 3], CAST([] AS ARRAY<INT64>), (acc, e) -> ARRAY_CONCAT(acc, [e]));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#3 AS `$col1` [ARRAY<INT64>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#3]
    +-expr_list=
    | +-$col1#3 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<INT64> array_to_reduce, ARRAY<INT64> initial_value, FUNCTION<(ARRAY<INT64>, INT64)->ARRAY<INT64>> reducer, optional(1) BOOL ignore_nulls) -> ARRAY<INT64>)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<INT64>, value=[1, 2, 3])
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<INT64>, value=[], has_explicit_type=TRUE)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, e#2]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:array_concat(ARRAY<INT64>, repeated(1) ARRAY<INT64>) -> ARRAY<INT64>)
    |     |         +-ColumnRef(type=ARRAY<INT64>, column=$lambda_arg.acc#1)
    |     |         +-FunctionCall(GoogleSQL:$make_array(repeated(1) INT64) -> ARRAY<INT64>)
    |     |           +-ColumnRef(type=INT64, column=$lambda_arg.e#2)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

# 3-argument lambda reduction with index on non-INT64 array and accumulator
SELECT ARRAY_REDUCE(['a', 'b', 'c'], '', (acc, e, i) -> CONCAT(acc, e, ':', CAST(i AS STRING)));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#4 AS `$col1` [STRING]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#4]
    +-expr_list=
    | +-$col1#4 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<STRING> array_to_reduce, STRING initial_value, FUNCTION<(STRING, STRING, INT64)->STRING> reducer, optional(1) BOOL ignore_nulls) -> STRING)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<STRING>, value=["a", "b", "c"])
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=STRING, value="")
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, e#2, i#3]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:concat(STRING, repeated(3) STRING) -> STRING)
    |     |         +-ColumnRef(type=STRING, column=$lambda_arg.acc#1)
    |     |         +-ColumnRef(type=STRING, column=$lambda_arg.e#2)
    |     |         +-Literal(type=STRING, value=":")
    |     |         +-Cast(INT64 -> STRING)
    |     |           +-ColumnRef(type=INT64, column=$lambda_arg.i#3)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

# Reducing an array of STRUCT elements
SELECT ARRAY_REDUCE([STRUCT(1 AS a, 'x' AS b), STRUCT(2 AS a, 'y' AS b)], 0, (acc, s) -> acc + s.a);
