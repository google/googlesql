  +-ProjectScan
    +-column_list=[$query.$col1#3]
    +-expr_list=
    | +-$col1#3 :=
    |   +-FunctionCall(GoogleSQL:array_reduce(ARRAY<STRUCT<a INT64, b STRING>> array_to_reduce, INT64 initial_value, FUNCTION<(INT64, STRUCT<a INT64, b STRING>)->INT64> reducer, optional(1) BOOL ignore_nulls) -> INT64)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<STRUCT<a INT64, b STRING>>, value=[{a:1, b:"x"}, {a:2, b:"y"}])
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, s#2]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.acc#1)
    |     |         +-GetStructField
    |     |           +-type=INT64
    |     |           +-expr=
    |     |           | +-ColumnRef(type=STRUCT<a INT64, b STRING>, column=$lambda_arg.s#2)
    |     |           +-field_idx=0
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

