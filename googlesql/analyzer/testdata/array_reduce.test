    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=$lambda_arg.[acc#1, e#2, i#3]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.acc#1)
    |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.e#2)
    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.i#3)
    |     +-FunctionArgument
