    |     |         +-ColumnRef(type=INT64, column=$lambda_arg.acc#4)
    |     |         +-Literal(type=INT64, value=2)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=BOOL, value=false)
    +-input_scan=
      +-SingleRowScan
==

