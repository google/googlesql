# Typed NULL initial_value succeeds
SELECT ARRAY_REDUCE([1, 2, 3], CAST(NULL AS INT64), (acc, e) -> IFNULL(acc, 0) + e);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#3 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#3]
    +-expr_list=
