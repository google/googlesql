# STRING literals and identifiers are looked up separately. A STRING literal
# never finds a catalog table by name, and an identifier never finds a table
# that's only reachable through a STRING literal.
SELECT * FROM {{'KeyValue'|`users.csv`}} AS t
--
ALTERNATION GROUP: 'KeyValue'
--
ERROR: Cannot resolve string literal 'KeyValue' as a table [at 1:15]
SELECT * FROM 'KeyValue' AS t
              ^
--
ALTERNATION GROUP: `users.csv`
--
ERROR: Table not found: `users.csv` [at 1:15]
SELECT * FROM `users.csv` AS t
              ^
==

# A STRING literal table whose Table::Name() matches a catalog table.
# SQLBuilder prints the literal, not the identifier `KeyValue`, which would
# find a different table.
[show_sqlbuilder_output]
SELECT KeyValue.Key, kv.file_key FROM KeyValue, 'KeyValue.csv' AS kv
--
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS Key [INT64]
| +-KeyValue.file_key#3 AS file_key [INT64]
+-query=
  +-ProjectScan
    +-column_list=KeyValue.[Key#1, file_key#3]
    +-input_scan=
      +-JoinScan
        +-column_list=KeyValue.[Key#1, file_key#3]
        +-left_scan=
        | +-TableScan(column_list=[KeyValue.Key#1], table=KeyValue, column_index_list=[0])
        +-right_scan=
          +-TableScan(column_list=[KeyValue.file_key#3], table=KeyValue, column_index_list=[0], alias="kv", name_string="KeyValue.csv")

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
SELECT
  keyvalue_2.a_1 AS Key,
  tablescan_5.a_4 AS file_key
FROM
  (
    SELECT
      KeyValue.Key AS a_1
    FROM
      KeyValue
  ) AS keyvalue_2
  CROSS JOIN
  (
    SELECT
      a_3.file_key AS a_4
    FROM
      "KeyValue.csv" AS a_3
  ) AS tablescan_5;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Key AS a_1
|> AS keyvalue_2
|> CROSS JOIN
   (
     FROM
       "KeyValue.csv" AS a_3
     |> SELECT
          a_3.file_key AS a_4
     |> AS tablescan_5
   )
|> SELECT
     keyvalue_2.a_1 AS Key,
     tablescan_5.a_4 AS file_key;
==

# A correlated subquery that mixes the STRING literal table 'KeyValue.csv',
# whose Table::Name() is also `KeyValue`, in the outer query and the catalog
# table `KeyValue` in the subquery. SQLBuilder gives the literal table a
# generated alias, so neither table hides the other.
[show_sqlbuilder_output]
SELECT kv.file_key FROM 'KeyValue.csv' AS kv WHERE EXISTS (SELECT 1 FROM KeyValue WHERE KeyValue.Key = kv.file_key)
--
QueryStmt
+-output_column_list=
| +-KeyValue.file_key#1 AS file_key [INT64]
+-query=
  +-ProjectScan
    +-column_list=[KeyValue.file_key#1]
    +-input_scan=
      +-FilterScan
        +-column_list=[KeyValue.file_key#1]
        +-input_scan=
        | +-TableScan(column_list=[KeyValue.file_key#1], table=KeyValue, column_index_list=[0], alias="kv", name_string="KeyValue.csv")
        +-filter_expr=
          +-SubqueryExpr
            +-type=BOOL
            +-subquery_type=EXISTS
            +-parameter_list=
            | +-ColumnRef(type=INT64, column=KeyValue.file_key#1)
            +-subquery=
              +-ProjectScan
                +-column_list=[$expr_subquery.$col1#4]
                +-expr_list=
                | +-$col1#4 := Literal(type=INT64, value=1)
                +-input_scan=
                  +-FilterScan
                    +-column_list=[KeyValue.Key#2]
                    +-input_scan=
                    | +-TableScan(column_list=[KeyValue.Key#2], table=KeyValue, column_index_list=[0])
                    +-filter_expr=
                      +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
                        +-ColumnRef(type=INT64, column=KeyValue.Key#2)
                        +-ColumnRef(type=INT64, column=KeyValue.file_key#1, is_correlated=TRUE)

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
SELECT
  a_1.file_key AS file_key
FROM
  "KeyValue.csv" AS a_1
WHERE
  EXISTS(
    SELECT
      1 AS a_4
    FROM
      KeyValue
    WHERE
      (KeyValue.Key) = (a_1.file_key)
  );

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
FROM
  "KeyValue.csv" AS a_1
|> WHERE
     EXISTS(
       FROM
         KeyValue
       |> WHERE
            (KeyValue.Key) = (a_1.file_key)
       |> SELECT
            1 AS a_4
     )
|> SELECT
     a_1.file_key AS file_key;
==

