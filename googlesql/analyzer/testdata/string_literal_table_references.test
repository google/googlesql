# Tests for STRING literals used as table references in FROM, such as
# FROM '/path/to/file.csv'.
# See (broken link).
# The parser always accepts STRING literals here. The analyzer rejects them
# without FEATURE_STRING_LITERAL_TABLE_REFERENCES. With the feature, they are
# resolved through Catalog::FindTableFromString. The SampleCatalog registers
# several tables that can be found this way.

# Without the feature, all literal table references are rejected.
[language_features=MAXIMUM,-STRING_LITERAL_TABLE_REFERENCES]
{{SELECT * FROM 'users.csv'|SELECT * FROM KeyValue JOIN 'users.csv' USING (Key)|FROM 'users.csv'}}
--
ALTERNATION GROUP: SELECT * FROM 'users.csv'
--
ERROR: String literal table references are not supported [at 1:15]
SELECT * FROM 'users.csv'
              ^
--
ALTERNATION GROUP: SELECT * FROM KeyValue JOIN 'users.csv' USING (Key)
--
ERROR: String literal table references are not supported [at 1:29]
SELECT * FROM KeyValue JOIN 'users.csv' USING (Key)
                            ^
--
ALTERNATION GROUP: FROM 'users.csv'
--
ERROR: String literal table references are not supported [at 1:6]
FROM 'users.csv'
     ^
==

[show_extracted_table_names]
[language_features=MAXIMUM,-STRING_LITERAL_TABLE_REFERENCES]
SELECT * FROM 'users.csv'
--
Extracted table names:
ERROR: String literal table references are not supported [at 1:15]
SELECT * FROM 'users.csv'
              ^
ERROR: String literal table references are not supported [at 1:15]
SELECT * FROM 'users.csv'
              ^
==

# TODO: b/568351814 - Remove the no_* defaults below:
# - no_run_deserializer: the Resolved AST deserializer finds a
#   ResolvedTableScan's table with Catalog::FindTable(Table::FullName()), even
#   if `name_string` is set. Tables that are only reachable through
#   FindTableFromString aren't found by name (or a different table with the
#   same name is found).
# - no_test_extract_table_names: ExtractTableNames still returns an error for
#   STRING literals, so the check that it succeeds whenever analysis succeeds
#   fails. It will return them in a separate output.
# - no_java: The Java test catalog is the SampleCatalog sent as a
#   SimpleCatalogProto, which doesn't include the STRING literal tables yet.
[default language_features=MAXIMUM,+STRING_LITERAL_TABLE_REFERENCES]
[default no_run_deserializer]
[default no_test_extract_table_names]
[default no_java]

SELECT {{*|name|u.name}} FROM 'users.csv' AS u
--
ALTERNATION GROUP: *
--
QueryStmt
+-output_column_list=
| +-users.user_id#1 AS user_id [INT64]
| +-users.name#2 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=users.[user_id#1, name#2]
    +-input_scan=
      +-TableScan(column_list=users.[user_id#1, name#2], table=users, column_index_list=[0, 1], alias="u", name_string="users.csv")
--
ALTERNATION GROUPS:
    name
    u.name
--
QueryStmt
+-output_column_list=
| +-users.name#2 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=[users.name#2]
    +-input_scan=
      +-TableScan(column_list=[users.name#2], table=users, column_index_list=[1], alias="u", name_string="users.csv")
==

# The analyzer passes the literal's value, after unescaping and concatenation,
# to Catalog::FindTableFromString. It doesn't interpret the value. All of these
# have the value `users.csv`, which SampleCatalog maps to the `users` table.
# ResolvedTableScan records the value in `name_string`, and SQLBuilder prints it
# back as a STRING literal with an explicit alias.
[show_sqlbuilder_output]
SELECT * FROM {{'users.csv'|"users.csv"|r'users.csv'|'''users.csv'''|'users\x2Ecsv'|'users' '.csv'}} AS u
--
QueryStmt
+-output_column_list=
| +-users.user_id#1 AS user_id [INT64]
| +-users.name#2 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=users.[user_id#1, name#2]
    +-input_scan=
      +-TableScan(column_list=users.[user_id#1, name#2], table=users, column_index_list=[0, 1], alias="u", name_string="users.csv")

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
SELECT
  a_1.user_id AS user_id,
  a_1.name AS name
FROM
  "users.csv" AS a_1;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
FROM
  "users.csv" AS a_1
|> SELECT
     a_1.user_id AS user_id,
     a_1.name AS name;
==

# Literals that don't name a table. The error message shows the value, quoted
# and escaped as a STRING literal. An empty literal is rejected before the
# Catalog lookup.
SELECT * FROM {{'no_such_file.csv'|"o'brien.csv"|r'C:\data\file.csv'|'数据.csv'|''}} AS t
--
ALTERNATION GROUP: 'no_such_file.csv'
--
ERROR: Cannot resolve string literal 'no_such_file.csv' as a table [at 1:15]
SELECT * FROM 'no_such_file.csv' AS t
              ^
--
ALTERNATION GROUP: "o'brien.csv"
--
ERROR: Cannot resolve string literal 'o\'brien.csv' as a table [at 1:15]
SELECT * FROM "o'brien.csv" AS t
              ^
--
ALTERNATION GROUP: r'C:\data\file.csv'
--
ERROR: Cannot resolve string literal 'C:\\data\\file.csv' as a table [at 1:15]
SELECT * FROM r'C:\data\file.csv' AS t
              ^
--
ALTERNATION GROUP: '数据.csv'
--
ERROR: Cannot resolve string literal '数据.csv' as a table [at 1:15]
SELECT * FROM '数据.csv' AS t
              ^
--
ALTERNATION GROUP: ''
--
ERROR: String literal table reference cannot be empty [at 1:15]
SELECT * FROM '' AS t
              ^
==

# Joins with a catalog table, with the literal on either side. On the rhs, the
# literal is never treated as an UNNEST or a correlated array reference.
SELECT * FROM {{KeyValue JOIN 'users.csv' AS u|'users.csv' AS u JOIN KeyValue}} ON KeyValue.Key = u.user_id
--
ALTERNATION GROUP: KeyValue JOIN 'users.csv' AS u
--
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS Key [INT64]
| +-KeyValue.Value#2 AS Value [STRING]
| +-users.user_id#3 AS user_id [INT64]
| +-users.name#4 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=[KeyValue.Key#1, KeyValue.Value#2, users.user_id#3, users.name#4]
    +-input_scan=
      +-JoinScan
        +-column_list=[KeyValue.Key#1, KeyValue.Value#2, users.user_id#3, users.name#4]
        +-left_scan=
        | +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
        +-right_scan=
        | +-TableScan(column_list=users.[user_id#3, name#4], table=users, column_index_list=[0, 1], alias="u", name_string="users.csv")
        +-join_expr=
          +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
            +-ColumnRef(type=INT64, column=KeyValue.Key#1)
            +-ColumnRef(type=INT64, column=users.user_id#3)
--
ALTERNATION GROUP: 'users.csv' AS u JOIN KeyValue
--
QueryStmt
+-output_column_list=
| +-users.user_id#1 AS user_id [INT64]
| +-users.name#2 AS name [STRING]
| +-KeyValue.Key#3 AS Key [INT64]
| +-KeyValue.Value#4 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=[users.user_id#1, users.name#2, KeyValue.Key#3, KeyValue.Value#4]
    +-input_scan=
      +-JoinScan
        +-column_list=[users.user_id#1, users.name#2, KeyValue.Key#3, KeyValue.Value#4]
        +-left_scan=
        | +-TableScan(column_list=users.[user_id#1, name#2], table=users, column_index_list=[0, 1], alias="u", name_string="users.csv")
        +-right_scan=
        | +-TableScan(column_list=KeyValue.[Key#3, Value#4], table=KeyValue, column_index_list=[0, 1])
        +-join_expr=
          +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
            +-ColumnRef(type=INT64, column=KeyValue.Key#3)
            +-ColumnRef(type=INT64, column=users.user_id#1)
==

# Without an explicit alias, the range variable is derived from the literal's
# path: the basename without shard suffixes and extensions. This works with
# postfix operators too.
SELECT users.name
FROM 'users.csv'{{| @{hint=1}| TABLESAMPLE SYSTEM (10 PERCENT)}}
--
ALTERNATION GROUP: <empty>
--
QueryStmt
+-output_column_list=
| +-users.name#2 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=[users.name#2]
    +-input_scan=
      +-TableScan(column_list=[users.name#2], table=users, column_index_list=[1], name_string="users.csv")
--
ALTERNATION GROUP:  @{hint=1}
--
QueryStmt
+-output_column_list=
| +-users.name#2 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=[users.name#2]
    +-input_scan=
      +-TableScan
        +-column_list=[users.name#2]
        +-hint_list=
        | +-hint := Literal(type=INT64, value=1)
        +-table=users
        +-column_index_list=[1]
        +-name_string="users.csv"
--
ALTERNATION GROUP:  TABLESAMPLE SYSTEM (10 PERCENT)
--
QueryStmt
+-output_column_list=
| +-users.name#2 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=[users.name#2]
    +-input_scan=
      +-SampleScan
        +-column_list=[users.name#2]
        +-input_scan=
        | +-TableScan(column_list=[users.name#2], table=users, column_index_list=[1], name_string="users.csv")
        +-method="system"
        +-size=
        | +-Literal(type=INT64, value=10)
        +-unit=PERCENT
==

# PIVOT and UNPIVOT work on an implicitly aliased literal. As with any table,
# its range variable isn't visible after them.
SELECT {{*|users.user_id}}
FROM 'users.csv' PIVOT(COUNT(*) FOR name IN ('a'))
--
ALTERNATION GROUP: *
--
QueryStmt
+-output_column_list=
| +-$groupby.user_id#4 AS user_id [INT64]
| +-$pivot.a#5 AS a [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$groupby.user_id#4, $pivot.a#5]
    +-input_scan=
      +-PivotScan
        +-column_list=[$groupby.user_id#4, $pivot.a#5]
        +-input_scan=
        | +-TableScan(column_list=users.[user_id#1, name#2], table=users, column_index_list=[0, 1], name_string="users.csv")
        +-group_by_list=
        | +-user_id#4 := ColumnRef(type=INT64, column=users.user_id#1)
        +-pivot_expr_list=
        | +-AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)(parse_location=32-40)
        +-for_expr=
        | +-ColumnRef(parse_location=45-49, type=STRING, column=users.name#2)
        +-pivot_value_list=
        | +-Literal(type=STRING, value="a", preserve_in_literal_remover=TRUE)
        +-pivot_column_list=
          +-PivotColumn(column=$pivot.a#5, pivot_expr_index=0, pivot_value_index=0)
--
ALTERNATION GROUP: users.user_id
--
ERROR: Unrecognized name: users; Did you mean user_id? [at 1:8]
SELECT users.user_id
       ^
==

SELECT * FROM 'users.csv' UNPIVOT(v FOR c IN (user_id))
--
QueryStmt
+-output_column_list=
| +-$unpivot.name#5 AS name [STRING]
| +-$unpivot.v#3 AS v [INT64]
| +-$unpivot.c#4 AS c [STRING]
+-query=
  +-ProjectScan
    +-column_list=$unpivot.[name#5, v#3, c#4]
    +-input_scan=
      +-UnpivotScan
        +-column_list=$unpivot.[name#5, v#3, c#4]
        +-input_scan=
        | +-TableScan(column_list=users.[user_id#1, name#2], table=users, column_index_list=[0, 1], name_string="users.csv")
        +-value_column_list=[$unpivot.v#3]
        +-label_column=$unpivot.c#4
        +-label_list=
        | +-Literal(type=STRING, value="user_id")
        +-unpivot_arg_list=
        | +-UnpivotArg
        |   +-column_list=
        |     +-ColumnRef(type=INT64, column=users.user_id#1)
        +-projected_input_column_list=
        | +-name#5 := ColumnRef(type=STRING, column=users.name#2)
        +-include_nulls=FALSE
==

# The range variable is the name derived from the literal, not the table's
# Table::Name(). Here it needs backticks.
SELECT {{`2026-09-24`.message|daily_logs.message}} FROM 'logs/2026-09-24.csv'
--
ALTERNATION GROUP: `2026-09-24`.message
--
QueryStmt
+-output_column_list=
| +-daily_logs.message#2 AS message [STRING]
+-query=
  +-ProjectScan
    +-column_list=[daily_logs.message#2]
    +-input_scan=
      +-TableScan(column_list=[daily_logs.message#2], table=daily_logs, column_index_list=[1], name_string="logs/2026-09-24.csv")
--
ALTERNATION GROUP: daily_logs.message
--
ERROR: Unrecognized name: daily_logs [at 1:8]
SELECT daily_logs.message FROM 'logs/2026-09-24.csv'
       ^
==

# A derived range variable hides a column with the same name, as any range
# variable does. Here `orders` is both the derived name and a column.
SELECT orders, orders.orders FROM 'orders/*.csv'
--
QueryStmt
+-output_column_list=
| +-$query.orders#4 AS orders [STRUCT<order_id INT64, orders INT64>]
| +-all_orders.orders#2 AS orders [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.orders#4, all_orders.orders#2]
    +-expr_list=
    | +-orders#4 :=
    |   +-MakeStruct
    |     +-type=STRUCT<order_id INT64, orders INT64>
    |     +-field_list=
    |       +-ColumnRef(type=INT64, column=all_orders.order_id#1)
    |       +-ColumnRef(type=INT64, column=all_orders.orders#2)
    +-input_scan=
      +-TableScan(column_list=all_orders.[order_id#1, orders#2], table=all_orders, column_index_list=[0, 1], name_string="orders/*.csv")
==

SELECT events.service FROM '/cns/cell/logs/events@100.tfrecords'
--
QueryStmt
+-output_column_list=
| +-events.service#2 AS service [STRING]
+-query=
  +-ProjectScan
    +-column_list=[events.service#2]
    +-input_scan=
      +-TableScan(column_list=[events.service#2], table=events, column_index_list=[1], name_string="/cns/cell/logs/events@100.tfrecords")
==

# For a value table, the derived name refers to the whole row.
SELECT {{extra|int32_val1}} FROM 'extra.tfrecords'
--
ALTERNATION GROUP: extra
--
QueryStmt
+-output_column_list=
| +-extra.value#1 AS extra [PROTO<googlesql_test.TestExtraPB>]
+-query=
  +-ProjectScan
    +-column_list=[extra.value#1]
    +-input_scan=
      +-TableScan(column_list=[extra.value#1], table=extra, column_index_list=[0], name_string="extra.tfrecords")
--
ALTERNATION GROUP: int32_val1
--
QueryStmt
+-output_column_list=
| +-$query.int32_val1#2 AS int32_val1 [INT32]
+-query=
  +-ProjectScan
    +-column_list=[$query.int32_val1#2]
    +-expr_list=
    | +-int32_val1#2 :=
    |   +-GetProtoField
    |     +-type=INT32
    |     +-expr=
    |     | +-ColumnRef(type=PROTO<googlesql_test.TestExtraPB>, column=extra.value#1)
    |     +-field_descriptor=int32_val1
    |     +-default_value=0
    +-input_scan=
      +-TableScan(column_list=[extra.value#1], table=extra, column_index_list=[0], name_string="extra.tfrecords")
==

SELECT arrays.key, v FROM 'arrays.tfrecords', arrays.int_array AS v
--
QueryStmt
+-output_column_list=
| +-arrays.key#1 AS key [INT64]
| +-$array.v#3 AS v [INT64]
+-query=
  +-ProjectScan
    +-column_list=[arrays.key#1, $array.v#3]
    +-input_scan=
      +-ArrayScan
        +-column_list=[arrays.key#1, arrays.int_array#2, $array.v#3]
        +-input_scan=
        | +-TableScan(column_list=arrays.[key#1, int_array#2], table=arrays, column_index_list=[0, 1], name_string="arrays.tfrecords")
        +-array_expr_list=
        | +-ColumnRef(type=ARRAY<INT64>, column=arrays.int_array#2)
        +-element_column_list=[$array.v#3]
==

# An explicit alias replaces the derived name.
SELECT users.name FROM 'users.csv' AS u
--
ERROR: Unrecognized name: users; Did you mean user_id? [at 1:8]
SELECT users.name FROM 'users.csv' AS u
       ^
==

# Derived names in other FROM item positions.
SELECT KeyValue.Value, users.name
FROM KeyValue JOIN 'users.csv' ON KeyValue.Key = users.user_id
--
QueryStmt
+-output_column_list=
| +-KeyValue.Value#2 AS Value [STRING]
| +-users.name#4 AS name [STRING]
+-query=
  +-ProjectScan
    +-column_list=[KeyValue.Value#2, users.name#4]
    +-input_scan=
      +-JoinScan
        +-column_list=[KeyValue.Key#1, KeyValue.Value#2, users.user_id#3, users.name#4]
        +-left_scan=
        | +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
        +-right_scan=
        | +-TableScan(column_list=users.[user_id#3, name#4], table=users, column_index_list=[0, 1], name_string="users.csv")
        +-join_expr=
          +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
            +-ColumnRef(type=INT64, column=KeyValue.Key#1)
            +-ColumnRef(type=INT64, column=users.user_id#3)
==

SELECT * FROM (SELECT users.user_id FROM 'users.csv')
--
QueryStmt
+-output_column_list=
| +-users.user_id#1 AS user_id [INT64]
+-query=
  +-ProjectScan
    +-column_list=[users.user_id#1]
    +-input_scan=
      +-ProjectScan
        +-column_list=[users.user_id#1]
        +-input_scan=
          +-TableScan(column_list=[users.user_id#1], table=users, column_index_list=[0], name_string="users.csv")
==

FROM 'users.csv'
|> JOIN '/cns/cell/logs/events@100.tfrecords' USING (user_id)
|> SELECT users.name, events.service
--
QueryStmt
+-output_column_list=
| +-users.name#2 AS name [STRING]
| +-events.service#4 AS service [STRING]
+-query=
  +-ProjectScan
    +-column_list=[users.name#2, events.service#4]
    +-input_scan=
      +-JoinScan
        +-column_list=[users.user_id#1, users.name#2, events.user_id#3, events.service#4]
        +-left_scan=
        | +-TableScan(column_list=users.[user_id#1, name#2], table=users, column_index_list=[0, 1], name_string="users.csv")
        +-right_scan=
        | +-TableScan(column_list=events.[user_id#3, service#4], table=events, column_index_list=[0, 1], name_string="/cns/cell/logs/events@100.tfrecords")
        +-join_expr=
        | +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
        |   +-ColumnRef(type=INT64, column=users.user_id#1)
        |   +-ColumnRef(type=INT64, column=events.user_id#3)
        +-has_using=TRUE
==

INSERT INTO KeyValue (Key, Value)
SELECT users.user_id, users.name FROM 'users.csv'
--
InsertStmt
+-table_scan=
| +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
+-insert_column_list=KeyValue.[Key#1, Value#2]
+-query=
| +-ProjectScan
|   +-column_list=users.[user_id#3, name#4]
|   +-input_scan=
|     +-TableScan(column_list=users.[user_id#3, name#4], table=users, column_index_list=[0, 1], name_string="users.csv")
+-query_output_column_list=users.[user_id#3, name#4]
+-column_access_list=WRITE,WRITE
==

# A derived name can collide with another range variable in the same FROM
# clause, including one from a catalog table.
SELECT * FROM {{KeyValue, 'KeyValue.csv'|'users.csv', 'users.csv'}}
--
ALTERNATION GROUP: KeyValue, 'KeyValue.csv'
--
ERROR: Duplicate table alias KeyValue in the same FROM clause [at 1:25]
SELECT * FROM KeyValue, 'KeyValue.csv'
                        ^
--
ALTERNATION GROUP: 'users.csv', 'users.csv'
--
ERROR: Duplicate table alias users in the same FROM clause [at 1:28]
SELECT * FROM 'users.csv', 'users.csv'
                           ^
==

# When there's no single name (a list of paths, or a glob with no fixed
# directory), or the name would start with `$`, the scan is anonymous: there's
# no range variable, so only unqualified column names work.
SELECT {{*|order_id|sales.order_id|sales_and_returns.order_id}}
FROM 'sales.csv,returns.csv'
--
ALTERNATION GROUP: *
--
QueryStmt
+-output_column_list=
| +-sales_and_returns.order_id#1 AS order_id [INT64]
| +-sales_and_returns.amount#2 AS amount [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=sales_and_returns.[order_id#1, amount#2]
    +-input_scan=
      +-TableScan(column_list=sales_and_returns.[order_id#1, amount#2], table=sales_and_returns, column_index_list=[0, 1], name_string="sales.csv,returns.csv")
--
ALTERNATION GROUP: order_id
--
QueryStmt
+-output_column_list=
| +-sales_and_returns.order_id#1 AS order_id [INT64]
+-query=
  +-ProjectScan
    +-column_list=[sales_and_returns.order_id#1]
    +-input_scan=
      +-TableScan(column_list=[sales_and_returns.order_id#1], table=sales_and_returns, column_index_list=[0], name_string="sales.csv,returns.csv")
--
ALTERNATION GROUP: sales.order_id
--
ERROR: Unrecognized name: sales [at 1:8]
SELECT sales.order_id
       ^
--
ALTERNATION GROUP: sales_and_returns.order_id
--
ERROR: Unrecognized name: sales_and_returns [at 1:8]
SELECT sales_and_returns.order_id
       ^
==

SELECT {{tmp_key|tmp.tmp_key}} FROM '$tmp.csv'
--
ALTERNATION GROUP: tmp_key
--
QueryStmt
+-output_column_list=
| +-tmp.tmp_key#1 AS tmp_key [INT64]
+-query=
  +-ProjectScan
    +-column_list=[tmp.tmp_key#1]
    +-input_scan=
      +-TableScan(column_list=[tmp.tmp_key#1], table=tmp, column_index_list=[0], name_string="$tmp.csv")
--
ALTERNATION GROUP: tmp.tmp_key
--
ERROR: Unrecognized name: tmp [at 1:8]
SELECT tmp.tmp_key FROM '$tmp.csv'
       ^
==

# An anonymous value table.
SELECT {{*|int32_val1}} FROM '/*.tfrecords'
--
ALTERNATION GROUP: *
--
QueryStmt
+-output_column_list=
| +-$query.int32_val1#3 AS int32_val1 [INT32]
| +-$query.int32_val2#4 AS int32_val2 [INT32]
| +-$query.str_value#5 AS str_value [ARRAY<STRING>]
+-query=
  +-ProjectScan
    +-column_list=$query.[int32_val1#3, int32_val2#4, str_value#5]
    +-expr_list=
    | +-int32_val1#3 :=
    | | +-GetProtoField
    | |   +-type=INT32
    | |   +-expr=
    | |   | +-ColumnRef(type=PROTO<googlesql_test.TestExtraPB>, column=all_extra.value#1)
    | |   +-field_descriptor=int32_val1
    | |   +-default_value=0
    | +-int32_val2#4 :=
    | | +-GetProtoField
    | |   +-type=INT32
    | |   +-expr=
    | |   | +-ColumnRef(type=PROTO<googlesql_test.TestExtraPB>, column=all_extra.value#1)
    | |   +-field_descriptor=int32_val2
    | |   +-default_value=0
    | +-str_value#5 :=
    |   +-GetProtoField
    |     +-type=ARRAY<STRING>
    |     +-expr=
    |     | +-ColumnRef(type=PROTO<googlesql_test.TestExtraPB>, column=all_extra.value#1)
    |     +-field_descriptor=str_value
    |     +-default_value=[]
    +-input_scan=
