# Columns of a STRING literal table can be referenced from a correlated
# subquery.
SELECT (SELECT COUNT(*) FROM KeyValue WHERE Key = u.user_id) FROM 'users.csv' AS u
--
QueryStmt
+-output_column_list=
| +-$query.$col1#6 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#6]
    +-expr_list=
    | +-$col1#6 :=
    |   +-SubqueryExpr
    |     +-type=INT64
    |     +-subquery_type=SCALAR
    |     +-parameter_list=
    |     | +-ColumnRef(type=INT64, column=users.user_id#1)
    |     +-subquery=
    |       +-ProjectScan
    |         +-column_list=[$aggregate.$agg1#5]
    |         +-input_scan=
    |           +-AggregateScan
    |             +-column_list=[$aggregate.$agg1#5]
    |             +-input_scan=
    |             | +-FilterScan
    |             |   +-column_list=[KeyValue.Key#3]
    |             |   +-input_scan=
    |             |   | +-TableScan(column_list=[KeyValue.Key#3], table=KeyValue, column_index_list=[0])
    |             |   +-filter_expr=
    |             |     +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
    |             |       +-ColumnRef(type=INT64, column=KeyValue.Key#3)
    |             |       +-ColumnRef(type=INT64, column=users.user_id#1, is_correlated=TRUE)
    |             +-aggregate_list=
    |               +-$agg1#5 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
    +-input_scan=
      +-TableScan(column_list=[users.user_id#1], table=users, column_index_list=[0], alias="u", name_string="users.csv")
==

