# TVF with RowType table from pipe input.
FROM KeyValueLazy
|> CALL tvf_one_relation_arg_with_fixed_output()
--
ERROR: TVF table argument (from pipe input) cannot be a table with type ROW<KeyValueLazy> [at 2:9]
|> CALL tvf_one_relation_arg_with_fixed_output()
        ^
==

# TVF with RowType column from pipe input.
FROM KeyValueLazy
|> EXTEND 1 AS x
|> CALL tvf_one_relation_arg_with_fixed_output()
--
ERROR: TVF table argument (from pipe input) cannot include a column of type ROW<KeyValueLazy> [at 3:9]
|> CALL tvf_one_relation_arg_with_fixed_output()
        ^
==

