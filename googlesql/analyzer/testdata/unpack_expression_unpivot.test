  a_5 AS b,
  a_6 AS c
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.int_b AS a_2
    FROM
      MultipleColumns
  ) AS projectscan_3 UNPIVOT EXCLUDE NULLS ((a_4, a_5) FOR a_6 IN ((a_1, a_2) AS "col1_col2"));
==

[sql_builder_target_syntax_mode=pipe]
FROM (SELECT int_a AS col1, int_b AS col2 FROM MultipleColumns)
|> UNPIVOT((a, b) FOR c IN ((col1, **COLUMNS(['col2']))))
--
QueryStmt
+-output_column_list=
| +-$unpivot.a#7 AS a [INT64]
| +-$unpivot.b#8 AS b [INT64]
| +-$unpivot.c#9 AS c [STRING]
+-query=
  +-UnpivotScan
    +-column_list=$unpivot.[a#7, b#8, c#9]
    +-input_scan=
    | +-ProjectScan
    |   +-column_list=MultipleColumns.[int_a#1, int_b#3]
    |   +-input_scan=
    |     +-TableScan(column_list=MultipleColumns.[int_a#1, int_b#3], table=MultipleColumns, column_index_list=[0, 2])
    +-value_column_list=$unpivot.[a#7, b#8]
    +-label_column=$unpivot.c#9
    +-label_list=
    | +-Literal(type=STRING, value="col1_col2")
    +-unpivot_arg_list=
    | +-UnpivotArg
    |   +-column_list=
    |     +-ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    |     +-ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    +-include_nulls=FALSE

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.int_b AS a_2
|> AS projectscan_3
|> UNPIVOT EXCLUDE NULLS ((a_4, a_5) FOR a_6 IN ((a_1, a_2) AS "col1_col2"))
|> SELECT
     a_4 AS a,
     a_5 AS b,
     a_6 AS c;
==

################################################################################
#
# Negative test cases for UNPACK (**) in UNPIVOT
#
################################################################################

# Empty column list in UNPIVOT
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS([])))
--
ERROR: Empty column list in UNPIVOT [at 1:43]
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS([])))
                                          ^
==

# Multiple empty unpacks in UNPIVOT IN clause
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS([]), **COLUMNS([])))
--
ERROR: Empty column list in UNPIVOT [at 1:43]
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS([]), **COLUMNS([])))
                                          ^
==

# Both value column list and IN clause empty due to unpack
SELECT * FROM KeyValue UNPIVOT((**COLUMNS([])) for b in (**COLUMNS([])))
--
ERROR: Empty column list in UNPIVOT [at 1:57]
SELECT * FROM KeyValue UNPIVOT((**COLUMNS([])) for b in (**COLUMNS([])))
                                                        ^
==

# Type mismatch in UNPIVOT
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS(['Key', 'Value'])))
--
ERROR: The datatype of column does not match other datatypes in the IN clause. Expected INT64, Found STRING [at 1:44]
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS(['Key', 'Value'])))
                                           ^
==

# Non-existent column in UNPIVOT
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS(['NonExistent'])))
--
ERROR: Name NonExistent not found in the current scope [at 1:44]
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS(['NonExistent'])))
                                           ^
==

# Mismatched columns due to empty unpack in IN item
SELECT * FROM MultipleColumns UNPIVOT((a, b) for c in ((int_a, int_b), (**COLUMNS([]))))
--
ERROR: Empty column list in UNPIVOT [at 1:73]
...UNPIVOT((a, b) for c in ((int_a, int_b), (**COLUMNS([]))))
                                             ^
==

# Empty left side due to empty unpack
SELECT * FROM MultipleColumns UNPIVOT((**COLUMNS([])) for b in ((int_a)))
--
ERROR: Empty column list in UNPIVOT [at 1:40]
SELECT * FROM MultipleColumns UNPIVOT((**COLUMNS([])) for b in ((int_a)))
                                       ^
==

# Too many columns in IN item due to unpack
SELECT * FROM MultipleColumns UNPIVOT((a, b) for c in ((int_a, int_b), (**COLUMNS(['int_c', 'int_d', 'string_a']))))
--
ERROR: All column groups in UNPIVOT IN clause must have the same number of columns [at 1:73]
...UNPIVOT((a, b) for c in ((int_a, int_b), (**COLUMNS(['int_c', 'int_d', 'st...
                                             ^

