[default language_features=MAXIMUM,+COLUMN_LIST_SPEC]
[default show_sqlbuilder_output]
[default use_constant_evaluator]
[default sql_builder_target_syntax_mode=standard]

################################################################################
#
# Positive test cases for UNPACK (**) in UNPIVOT
#
################################################################################

# Single column unpack in UNPIVOT
SELECT * FROM KeyValue UNPIVOT(a for b in (**COLUMNS(['Key'])))
--
QueryStmt
+-output_column_list=
| +-$unpivot.Value#5 AS Value [STRING]
| +-$unpivot.a#3 AS a [INT64]
| +-$unpivot.b#4 AS b [STRING]
+-query=
  +-ProjectScan
    +-column_list=$unpivot.[Value#5, a#3, b#4]
    +-input_scan=
      +-UnpivotScan
        +-column_list=$unpivot.[Value#5, a#3, b#4]
        +-input_scan=
        | +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
        +-value_column_list=[$unpivot.a#3]
        +-label_column=$unpivot.b#4
        +-label_list=
        | +-Literal(type=STRING, value="Key")
        +-unpivot_arg_list=
        | +-UnpivotArg
        |   +-column_list=
        |     +-ColumnRef(type=INT64, column=KeyValue.Key#1)
        +-projected_input_column_list=
        | +-Value#5 := ColumnRef(type=STRING, column=KeyValue.Value#2)
        +-include_nulls=FALSE

[SQLBUILDER_OUTPUT]
SELECT
  a_2 AS Value,
  a_4 AS a,
  a_5 AS b
FROM
  (
    SELECT
      KeyValue.Key AS a_1,
      KeyValue.Value AS a_2
    FROM
      KeyValue
  ) AS keyvalue_3 UNPIVOT EXCLUDE NULLS (a_4 FOR a_5 IN ((a_1) AS "Key"));
==

[sql_builder_target_syntax_mode=pipe]
FROM KeyValue |> UNPIVOT(a for b in (**COLUMNS(['Key'])))
--
QueryStmt
+-output_column_list=
| +-$unpivot.Value#5 AS Value [STRING]
| +-$unpivot.a#3 AS a [INT64]
| +-$unpivot.b#4 AS b [STRING]
+-query=
  +-UnpivotScan
    +-column_list=$unpivot.[Value#5, a#3, b#4]
    +-input_scan=
    | +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
    +-value_column_list=[$unpivot.a#3]
    +-label_column=$unpivot.b#4
    +-label_list=
    | +-Literal(type=STRING, value="Key")
    +-unpivot_arg_list=
    | +-UnpivotArg
    |   +-column_list=
    |     +-ColumnRef(type=INT64, column=KeyValue.Key#1)
    +-projected_input_column_list=
    | +-Value#5 := ColumnRef(type=STRING, column=KeyValue.Value#2)
    +-include_nulls=FALSE

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Key AS a_1,
     KeyValue.Value AS a_2
|> AS keyvalue_3
|> UNPIVOT EXCLUDE NULLS (a_4 FOR a_5 IN ((a_1) AS "Key"))
|> SELECT
     a_2 AS Value,
     a_4 AS a,
     a_5 AS b;
==

# Multiple column unpack in UNPIVOT
SELECT * FROM MultipleColumns UNPIVOT(a for b in (**COLUMNS(['int_b']), **COLUMNS(['int_c'])))
--
QueryStmt
+-output_column_list=
| +-$unpivot.int_a#9 AS int_a [INT64]
| +-$unpivot.string_a#10 AS string_a [STRING]
| +-$unpivot.string_b#11 AS string_b [STRING]
| +-$unpivot.int_d#12 AS int_d [INT64]
| +-$unpivot.a#7 AS a [INT64]
| +-$unpivot.b#8 AS b [STRING]
+-query=
  +-ProjectScan
    +-column_list=$unpivot.[int_a#9, string_a#10, string_b#11, int_d#12, a#7, b#8]
    +-input_scan=
      +-UnpivotScan
        +-column_list=$unpivot.[int_a#9, string_a#10, string_b#11, int_d#12, a#7, b#8]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3, string_b#4, int_c#5, int_d#6], table=MultipleColumns, column_index_list=[0, 1, 2, 3, 4, 5])
        +-value_column_list=[$unpivot.a#7]
        +-label_column=$unpivot.b#8
        +-label_list=
        | +-Literal(type=STRING, value="int_b")
        | +-Literal(type=STRING, value="int_c")
        +-unpivot_arg_list=
        | +-UnpivotArg
        | | +-column_list=
        | |   +-ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-UnpivotArg
        |   +-column_list=
        |     +-ColumnRef(type=INT64, column=MultipleColumns.int_c#5)
        +-projected_input_column_list=
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        | +-string_b#11 := ColumnRef(type=STRING, column=MultipleColumns.string_b#4)
        | +-int_d#12 := ColumnRef(type=INT64, column=MultipleColumns.int_d#6)
        +-include_nulls=FALSE

[SQLBUILDER_OUTPUT]
SELECT
  a_1 AS int_a,
  a_2 AS string_a,
  a_4 AS string_b,
  a_6 AS int_d,
  a_8 AS a,
  a_9 AS b
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3,
      MultipleColumns.string_b AS a_4,
      MultipleColumns.int_c AS a_5,
      MultipleColumns.int_d AS a_6
    FROM
      MultipleColumns
  ) AS multiplecolumns_7 UNPIVOT EXCLUDE NULLS (a_8 FOR a_9 IN ((a_3) AS "int_b", (a_5) AS "int_c"));

==

