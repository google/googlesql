# Mixed columns unpack in UNPIVOT
SELECT * FROM MultipleColumns UNPIVOT(a for b in (int_a, **COLUMNS(['int_b', 'int_c'])))
--
QueryStmt
+-output_column_list=
| +-$unpivot.string_a#9 AS string_a [STRING]
| +-$unpivot.string_b#10 AS string_b [STRING]
| +-$unpivot.int_d#11 AS int_d [INT64]
| +-$unpivot.a#7 AS a [INT64]
| +-$unpivot.b#8 AS b [STRING]
+-query=
  +-ProjectScan
    +-column_list=$unpivot.[string_a#9, string_b#10, int_d#11, a#7, b#8]
    +-input_scan=
      +-UnpivotScan
        +-column_list=$unpivot.[string_a#9, string_b#10, int_d#11, a#7, b#8]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3, string_b#4, int_c#5, int_d#6], table=MultipleColumns, column_index_list=[0, 1, 2, 3, 4, 5])
        +-value_column_list=[$unpivot.a#7]
        +-label_column=$unpivot.b#8
        +-label_list=
        | +-Literal(type=STRING, value="int_a")
        | +-Literal(type=STRING, value="int_b")
        | +-Literal(type=STRING, value="int_c")
        +-unpivot_arg_list=
        | +-UnpivotArg
        | | +-column_list=
        | |   +-ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-UnpivotArg
        | | +-column_list=
        | |   +-ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-UnpivotArg
        |   +-column_list=
        |     +-ColumnRef(type=INT64, column=MultipleColumns.int_c#5)
        +-projected_input_column_list=
        | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        | +-string_b#10 := ColumnRef(type=STRING, column=MultipleColumns.string_b#4)
        | +-int_d#11 := ColumnRef(type=INT64, column=MultipleColumns.int_d#6)
        +-include_nulls=FALSE

[SQLBUILDER_OUTPUT]
SELECT
  a_2 AS string_a,
  a_4 AS string_b,
  a_6 AS int_d,
  a_8 AS a,
  a_9 AS b
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3,
      MultipleColumns.string_b AS a_4,
      MultipleColumns.int_c AS a_5,
      MultipleColumns.int_d AS a_6
    FROM
      MultipleColumns
  ) AS multiplecolumns_7 UNPIVOT EXCLUDE NULLS (a_8 FOR a_9 IN ((a_1) AS "int_a", (a_3) AS "int_b", (a_5) AS "int_c"));
