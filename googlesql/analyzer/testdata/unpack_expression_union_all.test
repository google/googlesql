[default language_features=MAXIMUM,+COLUMN_LIST_SPEC]
[default show_sqlbuilder_output]
[default use_constant_evaluator]
[default sql_builder_target_syntax_mode=standard]

[language_features=MAXIMUM,-COLUMN_LIST_SPEC]
# Error when FEATURE_COLUMN_LIST_SPEC is disabled
SELECT Key, Value FROM KeyValue
UNION ALL CORRESPONDING BY (**COLUMNS(['Key', 'Value']))
SELECT Value, Key FROM KeyValue
--
ERROR: Unpack expression (**) is not supported [at 3:29]
UNION ALL CORRESPONDING BY (**COLUMNS(['Key', 'Value']))
                            ^
==

################################################################################
#
# Positive test cases for UNPACK (**) in UNION ALL CORRESPONDING BY / BY NAME ON
#
################################################################################

# Basic UNION ALL CORRESPONDING BY
SELECT Key, Value FROM KeyValue
UNION ALL CORRESPONDING BY (**COLUMNS(['Key', 'Value']))
SELECT Value, Key FROM KeyValue
--
QueryStmt
+-output_column_list=
| +-$union_all.Key#5 AS Key [INT64]
| +-$union_all.Value#6 AS Value [STRING]
+-query=
  +-SetOperationScan
    +-column_list=$union_all.[Key#5, Value#6]
    +-op_type=UNION_ALL
    +-input_item_list=
    | +-SetOperationItem
    | | +-scan=
    | | | +-ProjectScan
    | | |   +-column_list=KeyValue.[Key#1, Value#2]
    | | |   +-input_scan=
    | | |     +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
    | | +-output_column_list=KeyValue.[Key#1, Value#2]
    | +-SetOperationItem
    |   +-scan=
    |   | +-ProjectScan
    |   |   +-column_list=KeyValue.[Key#3, Value#4]
    |   |   +-node_source="resolver_set_operation_corresponding"
    |   |   +-input_scan=
    |   |     +-ProjectScan
    |   |       +-column_list=KeyValue.[Value#4, Key#3]
    |   |       +-input_scan=
    |   |         +-TableScan(column_list=KeyValue.[Key#3, Value#4], table=KeyValue, column_index_list=[0, 1])
    |   +-output_column_list=KeyValue.[Key#3, Value#4]
    +-column_match_mode=CORRESPONDING_BY
    +-column_propagation_mode=INNER

[SQLBUILDER_OUTPUT]
(
SELECT
  KeyValue.Key AS Key,
  KeyValue.Value AS Value
FROM
  KeyValue
) UNION ALL CORRESPONDING BY (Key, Value)(
SELECT
  keyvalue_7.a_6 AS Value,
  keyvalue_7.a_5 AS Key
FROM
  (
    SELECT
      KeyValue.Key AS a_5,
      KeyValue.Value AS a_6
    FROM
      KeyValue
  ) AS keyvalue_7
);
==

# Basic UNION ALL BY NAME ON
SELECT Key, Value FROM KeyValue
UNION ALL BY NAME ON (**COLUMNS(['Key', 'Value']))
SELECT Value, Key FROM KeyValue
--
QueryStmt
+-output_column_list=
| +-$union_all.Key#5 AS Key [INT64]
| +-$union_all.Value#6 AS Value [STRING]
+-query=
  +-SetOperationScan
    +-column_list=$union_all.[Key#5, Value#6]
    +-op_type=UNION_ALL
    +-input_item_list=
    | +-SetOperationItem
    | | +-scan=
    | | | +-ProjectScan
    | | |   +-column_list=KeyValue.[Key#1, Value#2]
    | | |   +-input_scan=
    | | |     +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
    | | +-output_column_list=KeyValue.[Key#1, Value#2]
    | +-SetOperationItem
    |   +-scan=
    |   | +-ProjectScan
    |   |   +-column_list=KeyValue.[Key#3, Value#4]
    |   |   +-node_source="resolver_set_operation_corresponding"
    |   |   +-input_scan=
    |   |     +-ProjectScan
    |   |       +-column_list=KeyValue.[Value#4, Key#3]
    |   |       +-input_scan=
    |   |         +-TableScan(column_list=KeyValue.[Key#3, Value#4], table=KeyValue, column_index_list=[0, 1])
    |   +-output_column_list=KeyValue.[Key#3, Value#4]
    +-column_match_mode=CORRESPONDING_BY

[SQLBUILDER_OUTPUT]
(
SELECT
  KeyValue.Key AS Key,
  KeyValue.Value AS Value
FROM
  KeyValue
) UNION ALL STRICT CORRESPONDING BY (Key, Value)(
SELECT
  keyvalue_7.a_6 AS Value,
  keyvalue_7.a_5 AS Key
FROM
  (
    SELECT
      KeyValue.Key AS a_5,
      KeyValue.Value AS a_6
    FROM
      KeyValue
  ) AS keyvalue_7
);
==

# Combined with propagation mode modifier (FULL OUTER)
SELECT Key, Value FROM KeyValue
FULL OUTER UNION ALL CORRESPONDING BY (**COLUMNS(['Key', 'Value']))
SELECT Key FROM KeyValue
--
QueryStmt
+-output_column_list=
| +-$union_all.Key#5 AS Key [INT64]
| +-$union_all.Value#6 AS Value [STRING]
+-query=
  +-SetOperationScan
    +-column_list=$union_all.[Key#5, Value#6]
    +-op_type=UNION_ALL
    +-input_item_list=
    | +-SetOperationItem
    | | +-scan=
    | | | +-ProjectScan
    | | |   +-column_list=KeyValue.[Key#1, Value#2]
    | | |   +-input_scan=
    | | |     +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
    | | +-output_column_list=KeyValue.[Key#1, Value#2]
    | +-SetOperationItem
    |   +-scan=
    |   | +-ProjectScan
    |   |   +-column_list=[KeyValue.Key#3, $null_column_for_outer_set_op.Value#7]
    |   |   +-node_source="resolver_set_operation_corresponding"
    |   |   +-expr_list=
    |   |   | +-Value#7 := Literal(type=STRING, value=NULL)
    |   |   +-input_scan=
    |   |     +-ProjectScan
    |   |       +-column_list=[KeyValue.Key#3]
    |   |       +-input_scan=
    |   |         +-TableScan(column_list=[KeyValue.Key#3], table=KeyValue, column_index_list=[0])
    |   +-output_column_list=[KeyValue.Key#3, $null_column_for_outer_set_op.Value#7]
    +-column_match_mode=CORRESPONDING_BY
    +-column_propagation_mode=FULL

[SQLBUILDER_OUTPUT]
(
SELECT
  KeyValue.Key AS Key,
  KeyValue.Value AS Value
FROM
  KeyValue
) FULL UNION ALL CORRESPONDING BY (Key, Value)(
SELECT
  KeyValue.Key AS Key
FROM
  KeyValue
);
==

# Subset of columns
SELECT Key, Value FROM KeyValue
UNION ALL CORRESPONDING BY (**COLUMNS(['Key']))
SELECT Value, Key FROM KeyValue
--
QueryStmt
+-output_column_list=
| +-$union_all.Key#5 AS Key [INT64]
+-query=
  +-SetOperationScan
    +-column_list=[$union_all.Key#5]
    +-op_type=UNION_ALL
    +-input_item_list=
    | +-SetOperationItem
    | | +-scan=
    | | | +-ProjectScan
    | | |   +-column_list=[KeyValue.Key#1]
    | | |   +-node_source="resolver_set_operation_corresponding"
    | | |   +-input_scan=
    | | |     +-ProjectScan
    | | |       +-column_list=KeyValue.[Key#1, Value#2]
    | | |       +-input_scan=
    | | |         +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
    | | +-output_column_list=[KeyValue.Key#1]
    | +-SetOperationItem
    |   +-scan=
    |   | +-ProjectScan
    |   |   +-column_list=[KeyValue.Key#3]
    |   |   +-node_source="resolver_set_operation_corresponding"
    |   |   +-input_scan=
    |   |     +-ProjectScan
    |   |       +-column_list=KeyValue.[Value#4, Key#3]
    |   |       +-input_scan=
    |   |         +-TableScan(column_list=KeyValue.[Key#3, Value#4], table=KeyValue, column_index_list=[0, 1])
    |   +-output_column_list=[KeyValue.Key#3]
    +-column_match_mode=CORRESPONDING_BY
    +-column_propagation_mode=INNER

[SQLBUILDER_OUTPUT]
(
SELECT
  KeyValue.Key AS Key,
  KeyValue.Value AS a_3
FROM
  KeyValue
) UNION ALL CORRESPONDING BY (Key)(
SELECT
  keyvalue_6.a_5 AS a_5,
  keyvalue_6.a_4 AS Key
FROM
  (
    SELECT
      KeyValue.Key AS a_4,
      KeyValue.Value AS a_5
    FROM
      KeyValue
  ) AS keyvalue_6
);
==

