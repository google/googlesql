# `FROM x` matches a table parameter with different case.
[language_features=NONE,+TABLE_VALUED_FUNCTIONS,+CREATE_TABLE_FUNCTION]
CREATE TEMP TABLE FUNCTION Foo(NotATable TABLE<x INT64>)
AS (
  SELECT * FROM notatable
);
--

Table resolution time:

Extracted table names:
==

# `TABLE x` matches a table parameter with different case.
[language_features=NONE,+TABLE_VALUED_FUNCTIONS,+CREATE_TABLE_FUNCTION]
CREATE TEMP TABLE FUNCTION Foo(NotATable TABLE<x INT64>)
AS (
  SELECT * FROM tvf_one_relation_arg_with_fixed_output(TABLE notatable)
);
--
Table resolution time:

Extracted table names:

==

# `FROM x` matches a catalog table and a table argument with different case.
# This resolves to the argument, so no table name referenced.
[language_features=NONE,+TABLE_VALUED_FUNCTIONS,+CREATE_TABLE_FUNCTION]
CREATE TEMP TABLE FUNCTION Foo(KeyValue TABLE<x INT64>)
AS (
  SELECT * FROM keyvalue
);
--

Table resolution time:

Extracted table names:
==

# `TABLE x` matches a catalog table and a table argument with different case.
# This resolves to the argument, so no table name referenced.
[language_features=NONE,+TABLE_VALUED_FUNCTIONS,+CREATE_TABLE_FUNCTION]
CREATE TEMP TABLE FUNCTION Foo(KeyValue TABLE<x INT64>)
AS (
  SELECT * FROM tvf_one_relation_arg_with_fixed_output(TABLE keyvalue)
);
--
Table resolution time:

Extracted table names:
==

# Pipe FORK: tables referenced only inside subpipelines are extracted.
# TODO SQLBuilder doesn't work for pipe FORK/TEE yet, so the
# tests below use no_run_sqlbuilder.
[language_features=MAXIMUM,+PIPES,+PIPE_FORK,+PIPE_TEE,+PIPE_INSERT,+PIPE_CREATE_TABLE,+PIPE_EXPORT_DATA,+OMIT_INSERT_COLUMN_LIST]
[supported_statement_kinds=QUERY,GENERALIZED_QUERY]
[no_run_sqlbuilder]
FROM KeyValue
|> FORK (
     |> JOIN KeyValue2 USING (key)
   ), (
     |> WHERE key IN (SELECT int64 FROM SimpleTypes)
   )
--
Table resolution time:
KeyValue => {
DEFAULT;
}
KeyValue2 => {
DEFAULT;
}
SimpleTypes => {
DEFAULT;
}

Extracted table names:
KeyValue
KeyValue2
SimpleTypes
==

# Pipe TEE: tables referenced inside subpipelines and in the main pipeline
# after the TEE are all extracted.
[language_features=MAXIMUM,+PIPES,+PIPE_FORK,+PIPE_TEE,+PIPE_INSERT,+PIPE_CREATE_TABLE,+PIPE_EXPORT_DATA,+OMIT_INSERT_COLUMN_LIST]
[supported_statement_kinds=QUERY,GENERALIZED_QUERY]
[no_run_sqlbuilder]
FROM KeyValue AS kv
|> TEE (
     |> JOIN KeyValue2 USING (key)
   )
|> JOIN SimpleTypes ON kv.key = SimpleTypes.int64
--
Table resolution time:
KeyValue => {
DEFAULT;
}
KeyValue2 => {
DEFAULT;
}
SimpleTypes => {
DEFAULT;
}

Extracted table names:
KeyValue
KeyValue2
SimpleTypes
==

# Pipe FORK/TEE: the target of a pipe INSERT inside a subpipeline is extracted.
[language_features=MAXIMUM,+PIPES,+PIPE_FORK,+PIPE_TEE,+PIPE_INSERT,+PIPE_CREATE_TABLE,+PIPE_EXPORT_DATA,+OMIT_INSERT_COLUMN_LIST]
[supported_statement_kinds=QUERY,GENERALIZED_QUERY]
[no_run_sqlbuilder]
FROM KeyValue
|> {{FORK|TEE}} (
     |> INSERT INTO KeyValue2
   ), (
     |> CREATE TABLE NewTable
   ), (
     |> EXPORT DATA
   )
--
Table resolution time:
KeyValue => {
DEFAULT;
}
KeyValue2 => {
DEFAULT;
}

Extracted table names:
KeyValue
KeyValue2
==

# Nested FORK and TEE: tables referenced in nested subpipelines are extracted.
[language_features=MAXIMUM,+PIPES,+PIPE_FORK,+PIPE_TEE,+PIPE_INSERT,+PIPE_CREATE_TABLE,+PIPE_EXPORT_DATA,+OMIT_INSERT_COLUMN_LIST]
[supported_statement_kinds=QUERY,GENERALIZED_QUERY]
[no_run_sqlbuilder]
FROM KeyValue
|> FORK (
     |> TEE (
          |> JOIN KeyValue2 USING (key)
        )
     |> FORK (
          |> CROSS JOIN TestTable
        )
   )
--
Table resolution time:
KeyValue => {
DEFAULT;
}
KeyValue2 => {
DEFAULT;
}
TestTable => {
DEFAULT;
}

Extracted table names:
KeyValue
KeyValue2
TestTable
==

# Range variables visible on the input of a FORK subpipeline are not treated
# as table names inside the subpipeline.
[language_features=MAXIMUM,+PIPES,+PIPE_FORK,+PIPE_TEE,+PIPE_INSERT,+PIPE_CREATE_TABLE,+PIPE_EXPORT_DATA,+OMIT_INSERT_COLUMN_LIST]
[supported_statement_kinds=QUERY,GENERALIZED_QUERY]
[no_run_sqlbuilder]
FROM ArrayTypes AS a
|> {{FORK|TEE}} (
     |> CROSS JOIN a.Int32Array AS elem
     |> SELECT elem
   )
--
Table resolution time:
ArrayTypes => {
DEFAULT;
}

Extracted table names:
ArrayTypes
==

# A CTE defined inside one FORK subpipeline does not hide a catalog table
# with the same name in a sibling subpipeline.
[language_features=MAXIMUM,+PIPES,+PIPE_FORK,+PIPE_TEE,+PIPE_INSERT,+PIPE_CREATE_TABLE,+PIPE_EXPORT_DATA,+OMIT_INSERT_COLUMN_LIST]
[supported_statement_kinds=QUERY,GENERALIZED_QUERY]
[no_run_sqlbuilder]
FROM KeyValue
