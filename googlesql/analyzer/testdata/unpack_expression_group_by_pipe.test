[default language_features=MAXIMUM,+COLUMN_LIST_SPEC]
[default show_sqlbuilder_output]
[default use_constant_evaluator]
[default sql_builder_target_syntax_mode=pipe]

# Tests for UNPACK (**) expressions in pipe GROUP BY, i.e.
# |> AGGREGATE ... GROUP BY.
#
# Sections 1 and 2 follow the same structure as unpack_expression_group_by.test,
# which covers the same matrix for standard-syntax GROUP BY: plain GROUP BY,
# ROLLUP and CUBE (tested together via a {{ROLLUP|CUBE}} alternation, since
# they share one code path), and GROUPING SETS (including nested ROLLUP/CUBE).
# Within a case, variants that resolve identically (empty vs.
# parenthesized-empty expansion, **cols vs. **(cols)) are alternations rather
# than separate cases.
#
# The two files are not case-for-case identical, because some clauses exist in
# only one syntax:
#   - only here:     ordering suffixes, GROUP AND ORDER BY, and ** in the
#                    AGGREGATE list
#   - only there:    GROUP BY ALL and HAVING (neither is pipe syntax), a
#                    trailing ORDER BY (pipe uses |> ORDER BY), and grouping by
#                    a SELECT list alias, which pipe GROUP BY does not resolve
#                    (see the negative case for that below)

################################################################################
#
# Positive cases
#
################################################################################

# ------------------------------------------------------------------------------
# Plain GROUP BY
# ------------------------------------------------------------------------------

# ** expands into grouping columns, which pipe AGGREGATE also makes output
# columns.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS(['int_a', 'string_a']);

--
QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$groupby.string_a#9 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_a#8, $groupby.string_a#9, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
    +-group_by_list=
    | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2
|> AS multiplecolumns_3
|> EXTEND
     multiplecolumns_3.a_1 AS a_4,
     multiplecolumns_3.a_2 AS a_5
|> AGGREGATE
     COUNT(*) AS a_6
   GROUP BY a_4, a_5
|> AS aggregatescan_7
|> SELECT
     aggregatescan_7.a_4 AS int_a,
     aggregatescan_7.a_5 AS string_a,
     aggregatescan_7.a_6 AS a_6;
==

# The expansion is appended after grouping columns listed before it.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY int_b, **COLUMNS(['int_a', 'string_a']);

--
QueryStmt
+-output_column_list=
| +-$groupby.int_b#8 AS int_b [INT64]
| +-$groupby.int_a#9 AS int_a [INT64]
| +-$groupby.string_a#10 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_b#8, $groupby.int_a#9, $groupby.string_a#10, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
    +-group_by_list=
    | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2,
     MultipleColumns.int_b AS a_3
|> AS multiplecolumns_4
|> EXTEND
     multiplecolumns_4.a_3 AS a_5,
     multiplecolumns_4.a_1 AS a_6,
     multiplecolumns_4.a_2 AS a_7
|> AGGREGATE
     COUNT(*) AS a_8
   GROUP BY a_5, a_6, a_7
|> AS aggregatescan_9
|> SELECT
     aggregatescan_9.a_5 AS int_b,
     aggregatescan_9.a_6 AS int_a,
     aggregatescan_9.a_7 AS string_a,
     aggregatescan_9.a_8 AS a_8;
==

# An empty column list expands to nothing, leaving a whole-table aggregation
# with no grouping.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS([]);

--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(table=MultipleColumns)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> AGGREGATE
     COUNT(*) AS a_1
|> AS aggregatescan_2
|> SELECT
     aggregatescan_2.a_1 AS a_1;
==

# An empty expansion drops out, leaving only the explicit grouping column.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY int_b, **COLUMNS([]);

--
QueryStmt
+-output_column_list=
| +-$groupby.int_b#8 AS int_b [INT64]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_b#8, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=[MultipleColumns.int_b#3], table=MultipleColumns, column_index_list=[2])
    +-group_by_list=
    | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_b AS a_1
|> AS multiplecolumns_2
|> EXTEND
     multiplecolumns_2.a_1 AS a_3
|> AGGREGATE
     COUNT(*) AS a_4
   GROUP BY a_3
|> AS aggregatescan_5
|> SELECT
     aggregatescan_5.a_3 AS int_b,
     aggregatescan_5.a_4 AS a_4;
==

# A name repeated in the column list produces one grouping column, the same as a
# repeated explicit grouping column. Pipe AGGREGATE still emits one output
# column per expanded name, so that single column is output twice.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS(['int_a', 'int_a']);
--
QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_a#8, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=[MultipleColumns.int_a#1], table=MultipleColumns, column_index_list=[0])
    +-group_by_list=
    | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1
|> AS multiplecolumns_2
|> EXTEND
     multiplecolumns_2.a_1 AS a_3
|> AGGREGATE
     COUNT(*) AS a_4
   GROUP BY a_3
|> AS aggregatescan_5
|> SELECT
     aggregatescan_5.a_3 AS a_3,
     aggregatescan_5.a_3 AS a_6,
     aggregatescan_5.a_4 AS a_4
|> AS aggregatescan_5
|> SELECT
     aggregatescan_5.a_3 AS int_a,
     aggregatescan_5.a_3 AS int_a,
     aggregatescan_5.a_4 AS a_4;
==

# A column grouped both explicitly and through the expansion is grouped once,
# but is still output once per GROUP BY item.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY int_a, **COLUMNS(['int_a']);
--
QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_a#8, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=[MultipleColumns.int_a#1], table=MultipleColumns, column_index_list=[0])
    +-group_by_list=
    | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1
|> AS multiplecolumns_2
|> EXTEND
     multiplecolumns_2.a_1 AS a_3
|> AGGREGATE
     COUNT(*) AS a_4
   GROUP BY a_3
|> AS aggregatescan_5
|> SELECT
     aggregatescan_5.a_3 AS a_3,
     aggregatescan_5.a_3 AS a_6,
     aggregatescan_5.a_4 AS a_4
|> AS aggregatescan_5
|> SELECT
     aggregatescan_5.a_3 AS int_a,
     aggregatescan_5.a_3 AS int_a,
     aggregatescan_5.a_4 AS a_4;
==

# Two expansions in the same GROUP BY list each expand in place.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS(['int_a']), **COLUMNS(['string_a']);
--
QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$groupby.string_a#9 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_a#8, $groupby.string_a#9, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
    +-group_by_list=
    | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2
|> AS multiplecolumns_3
|> EXTEND
     multiplecolumns_3.a_1 AS a_4,
     multiplecolumns_3.a_2 AS a_5
|> AGGREGATE
     COUNT(*) AS a_6
   GROUP BY a_4, a_5
|> AS aggregatescan_7
|> SELECT
     aggregatescan_7.a_4 AS int_a,
     aggregatescan_7.a_5 AS string_a,
     aggregatescan_7.a_6 AS a_6;
==

# A column produced by two overlapping expansions is grouped once, keeping the
# position of its first occurrence. As with a repeated name above, pipe
# AGGREGATE still outputs that single column twice.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS(['int_a', 'string_a']), **COLUMNS(['string_a', 'int_b']);
--
QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$groupby.string_a#9 AS string_a [STRING]
| +-$groupby.string_a#9 AS string_a [STRING]
| +-$groupby.int_b#10 AS int_b [INT64]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_a#8, $groupby.string_a#9, $groupby.int_b#10, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
    +-group_by_list=
    | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    | +-int_b#10 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2,
     MultipleColumns.int_b AS a_3
|> AS multiplecolumns_4
|> EXTEND
     multiplecolumns_4.a_1 AS a_5,
     multiplecolumns_4.a_2 AS a_6,
     multiplecolumns_4.a_3 AS a_7
|> AGGREGATE
     COUNT(*) AS a_8
   GROUP BY a_5, a_6, a_7
|> AS aggregatescan_9
|> SELECT
     aggregatescan_9.a_5 AS a_5,
     aggregatescan_9.a_6 AS a_6,
     aggregatescan_9.a_6 AS a_10,
     aggregatescan_9.a_7 AS a_7,
     aggregatescan_9.a_8 AS a_8
|> AS aggregatescan_9
|> SELECT
     aggregatescan_9.a_5 AS int_a,
     aggregatescan_9.a_6 AS string_a,
     aggregatescan_9.a_6 AS string_a,
     aggregatescan_9.a_7 AS int_b,
     aggregatescan_9.a_8 AS a_8;
==

# Names are matched case-insensitively, and the name as written in the column
# list becomes the output column name.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS(['INT_A', 'String_A']);
--
QueryStmt
+-output_column_list=
| +-$groupby.INT_A#8 AS INT_A [INT64]
| +-$groupby.String_A#9 AS String_A [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.INT_A#8, $groupby.String_A#9, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
    +-group_by_list=
    | +-INT_A#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-String_A#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
      +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2
|> AS multiplecolumns_3
|> EXTEND
     multiplecolumns_3.a_1 AS a_4,
     multiplecolumns_3.a_2 AS a_5
|> AGGREGATE
     COUNT(*) AS a_6
   GROUP BY a_4, a_5
|> AS aggregatescan_7
|> SELECT
     aggregatescan_7.a_4 AS INT_A,
     aggregatescan_7.a_5 AS String_A,
     aggregatescan_7.a_6 AS a_6;
==

# ------------------------------------------------------------------------------
# ROLLUP and CUBE
# ------------------------------------------------------------------------------
#
# ROLLUP and CUBE handle ** identically so each case runs for both.

# An unparenthesized ** expands into one element per column, keeping its
# position relative to explicit elements. Parentheses around the operand, as in
# **(cols), are part of the operand and make no difference.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY {{ROLLUP|CUBE}}(int_b,
     {{**COLUMNS(['int_a', 'string_a'])|**(COLUMNS(['int_a', 'string_a']))}});
--
ALTERNATION GROUPS:
    ROLLUP,**COLUMNS(['int_a', 'string_a'])
    ROLLUP,**(COLUMNS(['int_a', 'string_a']))
--
QueryStmt
+-output_column_list=
| +-$groupby.int_b#8 AS int_b [INT64]
| +-$groupby.int_a#9 AS int_a [INT64]
| +-$groupby.string_a#10 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_b#8, $groupby.int_a#9, $groupby.string_a#10, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
    +-group_by_list=
    | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
    | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
    +-grouping_set_list=
      +-Rollup
        +-rollup_column_list=
          +-GroupingSetMultiColumn
          | +-column_list=
          |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
          +-GroupingSetMultiColumn
          | +-column_list=
          |   +-ColumnRef(type=INT64, column=$groupby.int_a#9)
          +-GroupingSetMultiColumn
            +-column_list=
              +-ColumnRef(type=STRING, column=$groupby.string_a#10)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2,
     MultipleColumns.int_b AS a_3
|> AS multiplecolumns_4
|> EXTEND
     multiplecolumns_4.a_3 AS a_5,
     multiplecolumns_4.a_1 AS a_6,
     multiplecolumns_4.a_2 AS a_7
|> AGGREGATE
     COUNT(*) AS a_8
   GROUP BY ROLLUP(a_5, a_6, a_7)
|> AS aggregatescan_9
|> SELECT
     aggregatescan_9.a_5 AS int_b,
     aggregatescan_9.a_6 AS int_a,
     aggregatescan_9.a_7 AS string_a,
     aggregatescan_9.a_8 AS a_8;
--
ALTERNATION GROUPS:
    CUBE,**COLUMNS(['int_a', 'string_a'])
    CUBE,**(COLUMNS(['int_a', 'string_a']))
--
QueryStmt
+-output_column_list=
| +-$groupby.int_b#8 AS int_b [INT64]
| +-$groupby.int_a#9 AS int_a [INT64]
| +-$groupby.string_a#10 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_b#8, $groupby.int_a#9, $groupby.string_a#10, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
    +-group_by_list=
    | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
    | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
    +-grouping_set_list=
      +-Cube
        +-cube_column_list=
          +-GroupingSetMultiColumn
          | +-column_list=
          |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
          +-GroupingSetMultiColumn
          | +-column_list=
          |   +-ColumnRef(type=INT64, column=$groupby.int_a#9)
          +-GroupingSetMultiColumn
            +-column_list=
              +-ColumnRef(type=STRING, column=$groupby.string_a#10)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2,
     MultipleColumns.int_b AS a_3
|> AS multiplecolumns_4
|> EXTEND
     multiplecolumns_4.a_3 AS a_5,
     multiplecolumns_4.a_1 AS a_6,
     multiplecolumns_4.a_2 AS a_7
|> AGGREGATE
     COUNT(*) AS a_8
   GROUP BY CUBE(a_5, a_6, a_7)
|> AS aggregatescan_9
|> SELECT
     aggregatescan_9.a_5 AS int_b,
     aggregatescan_9.a_6 AS int_a,
     aggregatescan_9.a_7 AS string_a,
     aggregatescan_9.a_8 AS a_8;
==

# A parenthesized ** is a single multi-column element, the same as
# ROLLUP((int_a, string_a)), rather than one element per column.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY {{ROLLUP|CUBE}}(int_b, (**COLUMNS(['int_a', 'string_a'])));
--
ALTERNATION GROUP: ROLLUP
--
QueryStmt
+-output_column_list=
| +-$groupby.int_b#8 AS int_b [INT64]
| +-$groupby.int_a#9 AS int_a [INT64]
| +-$groupby.string_a#10 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_b#8, $groupby.int_a#9, $groupby.string_a#10, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
    +-group_by_list=
    | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
    | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
    +-grouping_set_list=
      +-Rollup
        +-rollup_column_list=
          +-GroupingSetMultiColumn
          | +-column_list=
          |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
          +-GroupingSetMultiColumn
            +-column_list=
              +-ColumnRef(type=INT64, column=$groupby.int_a#9)
              +-ColumnRef(type=STRING, column=$groupby.string_a#10)

[SQLBUILDER_OUTPUT]
FROM
  MultipleColumns
|> SELECT
     MultipleColumns.int_a AS a_1,
     MultipleColumns.string_a AS a_2,
     MultipleColumns.int_b AS a_3
|> AS multiplecolumns_4
|> EXTEND
     multiplecolumns_4.a_3 AS a_5,
     multiplecolumns_4.a_1 AS a_6,
     multiplecolumns_4.a_2 AS a_7
|> AGGREGATE
     COUNT(*) AS a_8
   GROUP BY ROLLUP(a_5, (a_6, a_7))
|> AS aggregatescan_9
|> SELECT
     aggregatescan_9.a_5 AS int_b,
     aggregatescan_9.a_6 AS int_a,
     aggregatescan_9.a_7 AS string_a,
     aggregatescan_9.a_8 AS a_8;
--
ALTERNATION GROUP: CUBE
--
QueryStmt
+-output_column_list=
| +-$groupby.int_b#8 AS int_b [INT64]
| +-$groupby.int_a#9 AS int_a [INT64]
| +-$groupby.string_a#10 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_b#8, $groupby.int_a#9, $groupby.string_a#10, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
    +-group_by_list=
    | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
    | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
    | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
