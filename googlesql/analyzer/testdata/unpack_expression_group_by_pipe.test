# Multi-column ROLLUP levels require GROUPING_SETS. Without it, an
# unparenthesized ** still works since each column is its own level, but a
# parenthesized ** is an error. CUBE needs no such case since it requires
# GROUPING_SETS outright.
[language_features=MAXIMUM,+COLUMN_LIST_SPEC,-GROUPING_SETS]
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY ROLLUP(
     {{**COLUMNS(['int_a', 'string_a'])|(**COLUMNS(['int_a', 'string_a']))}});
--
ALTERNATION GROUP: **COLUMNS(['int_a', 'string_a'])
--
QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$groupby.string_a#9 AS string_a [STRING]
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-AggregateScan
    +-column_list=[$groupby.int_a#8, $groupby.string_a#9, $aggregate.$agg1#7]
    +-input_scan=
    | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
    +-group_by_list=
    | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
    | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
    +-grouping_set_list=
    | +-GroupingSet
    | | +-group_by_column_list=
    | |   +-ColumnRef(type=INT64, column=$groupby.int_a#8)
    | |   +-ColumnRef(type=STRING, column=$groupby.string_a#9)
    | +-GroupingSet
    | | +-group_by_column_list=
    | |   +-ColumnRef(type=INT64, column=$groupby.int_a#8)
    | +-GroupingSet
    +-rollup_column_list=
      +-ColumnRef(type=INT64, column=$groupby.int_a#8)
      +-ColumnRef(type=STRING, column=$groupby.string_a#9)

[SQLBUILDER_OUTPUT]
