|> AGGREGATE COUNT(*)
   GROUP BY {{ROLLUP|CUBE}}({{**COLUMNS([])|(**COLUMNS([]))|**(COLUMNS([]))}});
--
ALTERNATION GROUP: ROLLUP,**COLUMNS([])
--
ERROR: ROLLUP must have at least one column [at 3:13]
   GROUP BY ROLLUP(**COLUMNS([]));
            ^
--
ALTERNATION GROUP: ROLLUP,(**COLUMNS([]))
--
ERROR: ROLLUP must have at least one column [at 3:13]
   GROUP BY ROLLUP((**COLUMNS([])));
            ^
--
ALTERNATION GROUP: ROLLUP,**(COLUMNS([]))
--
ERROR: ROLLUP must have at least one column [at 3:13]
   GROUP BY ROLLUP(**(COLUMNS([])));
            ^
--
ALTERNATION GROUP: CUBE,**COLUMNS([])
--
ERROR: CUBE must have at least one column [at 3:13]
   GROUP BY CUBE(**COLUMNS([]));
            ^
--
ALTERNATION GROUP: CUBE,(**COLUMNS([]))
--
ERROR: CUBE must have at least one column [at 3:13]
   GROUP BY CUBE((**COLUMNS([])));
            ^
--
ALTERNATION GROUP: CUBE,**(COLUMNS([]))
--
ERROR: CUBE must have at least one column [at 3:13]
   GROUP BY CUBE(**(COLUMNS([])));
            ^
==

# An empty parenthesized expansion is dropped rather than kept as an empty ()
# element, even when repeated.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY {{ROLLUP|CUBE}}(
     {{**COLUMNS([]), **COLUMNS([])|(**COLUMNS([])), (**COLUMNS([]))}});
--
ALTERNATION GROUPS:
    ROLLUP,**COLUMNS([]), **COLUMNS([])
    ROLLUP,(**COLUMNS([])), (**COLUMNS([]))
--
ERROR: ROLLUP must have at least one column [at 3:13]
   GROUP BY ROLLUP(
            ^
--
ALTERNATION GROUPS:
    CUBE,**COLUMNS([]), **COLUMNS([])
    CUBE,(**COLUMNS([])), (**COLUMNS([]))
--
ERROR: CUBE must have at least one column [at 3:13]
   GROUP BY CUBE(
            ^
==

# The check applies to each ROLLUP or CUBE on its own, even when other
# grouping items in the same GROUP BY do have columns.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY ROLLUP(int_a), {{ROLLUP|CUBE}}(**COLUMNS([]));
--
ALTERNATION GROUP: ROLLUP
--
ERROR: ROLLUP must have at least one column [at 3:28]
   GROUP BY ROLLUP(int_a), ROLLUP(**COLUMNS([]));
                           ^
--
ALTERNATION GROUP: CUBE
--
ERROR: CUBE must have at least one column [at 3:28]
   GROUP BY ROLLUP(int_a), CUBE(**COLUMNS([]));
                           ^
==

# The same applies to ROLLUP and CUBE nested inside GROUPING SETS.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY GROUPING SETS({{ROLLUP|CUBE}}((**COLUMNS([]))), int_b);
--
ALTERNATION GROUP: ROLLUP
--
ERROR: ROLLUP must have at least one column [at 3:27]
   GROUP BY GROUPING SETS(ROLLUP((**COLUMNS([]))), int_b);
                          ^
--
ALTERNATION GROUP: CUBE
--
ERROR: CUBE must have at least one column [at 3:27]
   GROUP BY GROUPING SETS(CUBE((**COLUMNS([]))), int_b);
                          ^
==

# GROUPING SETS requires at least one set, which an empty expansion cannot
# satisfy.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY GROUPING SETS(**COLUMNS([]));

--
ERROR: GROUPING SETS must have at least one column [at 3:13]
   GROUP BY GROUPING SETS(**COLUMNS([]));
            ^
==

# ------------------------------------------------------------------------------
# Aliasing
# ------------------------------------------------------------------------------

# An alias cannot be attached to ** in pipe GROUP BY or GROUP AND ORDER BY,
# with or without an ordering suffix.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP {{|AND ORDER }}BY **COLUMNS(['int_a', 'string_a']) AS a{{| DESC}};
--
ALTERNATION GROUP: <empty>
--
ERROR: AS alias is not allowed on unpack expressions [at 3:46]
   GROUP BY **COLUMNS(['int_a', 'string_a']) AS a;
                                             ^
--
ALTERNATION GROUP:  DESC
--
ERROR: AS alias is not allowed on unpack expressions [at 3:46]
   GROUP BY **COLUMNS(['int_a', 'string_a']) AS a DESC;
                                             ^
--
ALTERNATION GROUP: AND ORDER ,
--
ERROR: AS alias is not allowed on unpack expressions [at 3:56]
   GROUP AND ORDER BY **COLUMNS(['int_a', 'string_a']) AS a;
                                                       ^
--
ALTERNATION GROUP: AND ORDER , DESC
--
ERROR: AS alias is not allowed on unpack expressions [at 3:56]
   GROUP AND ORDER BY **COLUMNS(['int_a', 'string_a']) AS a DESC;
                                                       ^
==

# ------------------------------------------------------------------------------
# Columns that cannot be grouped
# ------------------------------------------------------------------------------

# A column of an ungroupable type is rejected the same way as when it is listed
# explicitly.
FROM ComplexTypes
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS(['KitchenSink']);
--
ERROR: Grouping by expressions of type PROTO is not allowed [at 3:15]
   GROUP BY **COLUMNS(['KitchenSink']);
              ^
==

# ------------------------------------------------------------------------------
# Name resolution
# ------------------------------------------------------------------------------

# A name in the column list that matches no column is an error.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY **COLUMNS(['bogus']);
--
ERROR: Name bogus not found in the current scope [at 3:15]
   GROUP BY **COLUMNS(['bogus']);
              ^
==

# ** in pipe GROUP BY resolves names against the pipe input only, so it does not
# see an alias defined in the same GROUP BY list. Standard syntax does resolve
# SELECT list aliases; see unpack_expression_group_by.test.
FROM MultipleColumns
|> AGGREGATE COUNT(*)
   GROUP BY int_a AS a, **COLUMNS(['a']);
--
ERROR: Name a not found in the current scope [at 3:27]
   GROUP BY int_a AS a, **COLUMNS(['a']);
                          ^
==

# ------------------------------------------------------------------------------
# Non-aggregate expressions in the pipe AGGREGATE list
# ------------------------------------------------------------------------------

# A ** in the AGGREGATE list expands to non-aggregate expressions, which pipe
# AGGREGATE does not allow.
FROM MultipleColumns
|> AGGREGATE **COLUMNS(['int_b']), COUNT(*)
   GROUP BY **COLUMNS(['int_a', 'string_a']);

--
ERROR: Pipe AGGREGATE cannot include non-aggregate expressions [at 2:14]
|> AGGREGATE **COLUMNS(['int_b']), COUNT(*)
             ^
==

# This holds even when the expanded column is also a grouping column.
FROM MultipleColumns
|> AGGREGATE **COLUMNS(['int_a']), COUNT(*)
   GROUP BY **COLUMNS(['int_a', 'string_a']);

--
ERROR: Pipe AGGREGATE cannot include non-aggregate expressions [at 2:14]
|> AGGREGATE **COLUMNS(['int_a']), COUNT(*)
             ^
