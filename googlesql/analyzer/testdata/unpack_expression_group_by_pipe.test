    | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
    +-aggregate_list=
    | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
    +-grouping_set_list=
