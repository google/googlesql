# Multi-column ROLLUP levels require GROUPING_SETS. Without it, an
# unparenthesized ** still works since each column is its own level, but a
# parenthesized ** is an error. CUBE needs no such case since it requires
# GROUPING_SETS outright.
[language_features=MAXIMUM,+COLUMN_LIST_SPEC,-GROUPING_SETS]
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY ROLLUP(
  {{**COLUMNS(['int_a', 'string_a'])|(**COLUMNS(['int_a', 'string_a']))}})
