[default language_features=MAXIMUM,+COLUMN_LIST_SPEC]
[default show_sqlbuilder_output]
[default use_constant_evaluator]
[default sql_builder_target_syntax_mode=standard]

# Tests for UNPACK (**) expressions in standard-syntax GROUP BY.
#
# Positive cases are grouped by construct: plain GROUP BY, ROLLUP and CUBE
# (tested together via a {{ROLLUP|CUBE}} alternation,), and GROUPING SETS
# (including nested ROLLUP/CUBE). Within a case,
# variants that resolve identically (empty vs. parenthesized-empty expansion,
# **cols vs. **(cols)) are alternations rather than separate cases.
#
# Pipe syntax (|> AGGREGATE ... GROUP BY) is covered in
# unpack_expression_group_by_pipe.test, which covers the same matrix and lists
# the few cases that exist in only one of the two syntaxes.
# ** in the SELECT list is covered in unpack_expression_select.test; this file
# only covers its interaction with GROUP BY.

################################################################################
#
# Positive cases
#
################################################################################

# ------------------------------------------------------------------------------
# Plain GROUP BY
# ------------------------------------------------------------------------------

# ** expands into one grouping column per name, in column list order.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['int_a', 'string_a'])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
        +-group_by_list=
        | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_4
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2
    FROM
      MultipleColumns
  ) AS multiplecolumns_3
GROUP BY multiplecolumns_3.a_1, multiplecolumns_3.a_2;
==

# The expansion is appended after grouping columns listed before it.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY int_b, **COLUMNS(['int_a', 'string_a'])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_5
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3
    FROM
      MultipleColumns
  ) AS multiplecolumns_4
GROUP BY multiplecolumns_4.a_3, multiplecolumns_4.a_1, multiplecolumns_4.a_2;
==

# An empty column list expands to nothing, leaving a whole-table aggregation
# with no grouping.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS([])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(table=MultipleColumns)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_1
FROM
  MultipleColumns;
==

# An empty expansion drops out, leaving only the explicit grouping column.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY int_b, **COLUMNS([])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=[MultipleColumns.int_b#3], table=MultipleColumns, column_index_list=[2])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_3
FROM
  (
    SELECT
      MultipleColumns.int_b AS a_1
    FROM
      MultipleColumns
  ) AS multiplecolumns_2
GROUP BY multiplecolumns_2.a_1;
==

# A name repeated in the column list produces one grouping column, the same as a
# repeated explicit grouping column.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['int_a', 'int_a'])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=[MultipleColumns.int_a#1], table=MultipleColumns, column_index_list=[0])
        +-group_by_list=
        | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_3
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1
    FROM
      MultipleColumns
  ) AS multiplecolumns_2
GROUP BY multiplecolumns_2.a_1;
==

# A column grouped both explicitly and through the expansion is grouped once.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY int_a, **COLUMNS(['int_a'])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=[MultipleColumns.int_a#1], table=MultipleColumns, column_index_list=[0])
        +-group_by_list=
        | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_3
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1
    FROM
      MultipleColumns
  ) AS multiplecolumns_2
GROUP BY multiplecolumns_2.a_1;
==

# Two expansions in the same GROUP BY list each expand in place.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['int_a']), **COLUMNS(['string_a'])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
        +-group_by_list=
        | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_4
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2
    FROM
      MultipleColumns
  ) AS multiplecolumns_3
GROUP BY multiplecolumns_3.a_1, multiplecolumns_3.a_2;
==

# A column produced by two overlapping expansions is grouped once, keeping the
# position of its first occurrence.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['int_a', 'string_a']), **COLUMNS(['string_a', 'int_b'])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
        +-group_by_list=
        | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        | +-int_b#10 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_5
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3
    FROM
      MultipleColumns
  ) AS multiplecolumns_4
GROUP BY multiplecolumns_4.a_1, multiplecolumns_4.a_2, multiplecolumns_4.a_3;
==

# Names are matched case-insensitively, and the grouping column takes the name
# as written in the column list rather than the catalog spelling.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['INT_A', 'String_A'])
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
        +-group_by_list=
        | +-INT_A#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-String_A#9 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
          +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_4
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2
    FROM
      MultipleColumns
  ) AS multiplecolumns_3
GROUP BY multiplecolumns_3.a_1, multiplecolumns_3.a_2;
==

# ------------------------------------------------------------------------------
# ROLLUP and CUBE
# ------------------------------------------------------------------------------
#
# ROLLUP and CUBE handle ** identically so each case runs for both.

# An unparenthesized ** expands into one element per column, keeping its
# position relative to explicit elements. Parentheses around the operand, as in
# **(cols), are part of the operand and make no difference.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY {{ROLLUP|CUBE}}(int_b,
  {{**COLUMNS(['int_a', 'string_a'])|**(COLUMNS(['int_a', 'string_a']))}})
--
ALTERNATION GROUPS:
    ROLLUP,**COLUMNS(['int_a', 'string_a'])
    ROLLUP,**(COLUMNS(['int_a', 'string_a']))
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
        | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
        +-grouping_set_list=
          +-Rollup
            +-rollup_column_list=
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_a#9)
              +-GroupingSetMultiColumn
                +-column_list=
                  +-ColumnRef(type=STRING, column=$groupby.string_a#10)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_5
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3
    FROM
      MultipleColumns
  ) AS multiplecolumns_4
GROUP BY ROLLUP(multiplecolumns_4.a_3, multiplecolumns_4.a_1, multiplecolumns_4.a_2);
--
ALTERNATION GROUPS:
    CUBE,**COLUMNS(['int_a', 'string_a'])
    CUBE,**(COLUMNS(['int_a', 'string_a']))
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
        | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
        +-grouping_set_list=
          +-Cube
            +-cube_column_list=
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_a#9)
              +-GroupingSetMultiColumn
                +-column_list=
                  +-ColumnRef(type=STRING, column=$groupby.string_a#10)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_5
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3
    FROM
      MultipleColumns
  ) AS multiplecolumns_4
GROUP BY CUBE(multiplecolumns_4.a_3, multiplecolumns_4.a_1, multiplecolumns_4.a_2);
==

# A parenthesized ** is a single multi-column element, the same as
# ROLLUP((int_a, string_a)), rather than one element per column.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY {{ROLLUP|CUBE}}(int_b, (**COLUMNS(['int_a', 'string_a'])))
--
ALTERNATION GROUP: ROLLUP
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
        | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
        +-grouping_set_list=
          +-Rollup
            +-rollup_column_list=
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
              +-GroupingSetMultiColumn
                +-column_list=
                  +-ColumnRef(type=INT64, column=$groupby.int_a#9)
                  +-ColumnRef(type=STRING, column=$groupby.string_a#10)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_5
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3
    FROM
      MultipleColumns
  ) AS multiplecolumns_4
GROUP BY ROLLUP(multiplecolumns_4.a_3, (multiplecolumns_4.a_1, multiplecolumns_4.a_2));
--
ALTERNATION GROUP: CUBE
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3], table=MultipleColumns, column_index_list=[0, 1, 2])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
        | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
        +-grouping_set_list=
          +-Cube
            +-cube_column_list=
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
              +-GroupingSetMultiColumn
                +-column_list=
                  +-ColumnRef(type=INT64, column=$groupby.int_a#9)
                  +-ColumnRef(type=STRING, column=$groupby.string_a#10)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_5
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3
    FROM
      MultipleColumns
  ) AS multiplecolumns_4
GROUP BY CUBE(multiplecolumns_4.a_3, (multiplecolumns_4.a_1, multiplecolumns_4.a_2));
==

# ** inside an explicit multi-column element expands in place into that
# element.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY {{ROLLUP|CUBE}}((int_b, **COLUMNS(['int_a', 'string_a'])), int_c)
--
ALTERNATION GROUP: ROLLUP
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3, int_c#5], table=MultipleColumns, column_index_list=[0, 1, 2, 4])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        | +-int_c#11 := ColumnRef(type=INT64, column=MultipleColumns.int_c#5)
        +-aggregate_list=
        | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
        +-grouping_set_list=
          +-Rollup
            +-rollup_column_list=
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
              |   +-ColumnRef(type=INT64, column=$groupby.int_a#9)
              |   +-ColumnRef(type=STRING, column=$groupby.string_a#10)
              +-GroupingSetMultiColumn
                +-column_list=
                  +-ColumnRef(type=INT64, column=$groupby.int_c#11)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_6
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3,
      MultipleColumns.int_c AS a_4
    FROM
      MultipleColumns
  ) AS multiplecolumns_5
GROUP BY ROLLUP((multiplecolumns_5.a_3, multiplecolumns_5.a_1, multiplecolumns_5.a_2), multiplecolumns_5.a_4);
--
ALTERNATION GROUP: CUBE
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2, int_b#3, int_c#5], table=MultipleColumns, column_index_list=[0, 1, 2, 4])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        | +-int_c#11 := ColumnRef(type=INT64, column=MultipleColumns.int_c#5)
        +-aggregate_list=
        | +-$agg1#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
        +-grouping_set_list=
          +-Cube
            +-cube_column_list=
              +-GroupingSetMultiColumn
              | +-column_list=
              |   +-ColumnRef(type=INT64, column=$groupby.int_b#8)
              |   +-ColumnRef(type=INT64, column=$groupby.int_a#9)
              |   +-ColumnRef(type=STRING, column=$groupby.string_a#10)
              +-GroupingSetMultiColumn
                +-column_list=
                  +-ColumnRef(type=INT64, column=$groupby.int_c#11)

[SQLBUILDER_OUTPUT]
SELECT
  COUNT(*) AS a_6
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1,
      MultipleColumns.string_a AS a_2,
      MultipleColumns.int_b AS a_3,
      MultipleColumns.int_c AS a_4
    FROM
      MultipleColumns
  ) AS multiplecolumns_5
GROUP BY CUBE((multiplecolumns_5.a_3, multiplecolumns_5.a_1, multiplecolumns_5.a_2), multiplecolumns_5.a_4);
==

# An empty expansion drops out, however it is parenthesized, leaving the
# explicit column as the only element.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY {{ROLLUP|CUBE}}(int_b,
  {{**COLUMNS([])|(**COLUMNS([]))|**(COLUMNS([]))}})
--
ALTERNATION GROUPS:
    ROLLUP,**COLUMNS([])
    ROLLUP,(**COLUMNS([]))
    ROLLUP,**(COLUMNS([]))
--
QueryStmt
+-output_column_list=
| +-$aggregate.$agg1#7 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$aggregate.$agg1#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$aggregate.$agg1#7]
        +-input_scan=
        | +-TableScan(column_list=[MultipleColumns.int_b#3], table=MultipleColumns, column_index_list=[2])
        +-group_by_list=
        | +-int_b#8 := ColumnRef(type=INT64, column=MultipleColumns.int_b#3)
        +-aggregate_list=
