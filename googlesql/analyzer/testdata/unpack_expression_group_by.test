QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$aggregate.n#7 AS n [INT64]
+-query=
  +-OrderByScan
    +-column_list=[$groupby.int_a#8, $aggregate.n#7]
    +-is_ordered=TRUE
    +-input_scan=
    | +-AggregateScan
    |   +-column_list=[$groupby.int_a#8, $aggregate.n#7]
    |   +-input_scan=
    |   | +-TableScan(column_list=[MultipleColumns.int_a#1], table=MultipleColumns, column_index_list=[0])
    |   +-group_by_list=
    |   | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
    |   +-aggregate_list=
    |     +-n#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
    +-order_by_item_list=
      +-OrderByItem
        +-column_ref=
          +-ColumnRef(type=INT64, column=$groupby.int_a#8)

[SQLBUILDER_OUTPUT]
SELECT
  aggregatescan_5.a_3 AS int_a,
  aggregatescan_5.a_4 AS n
FROM
  (
    SELECT
      multiplecolumns_2.a_1 AS a_3,
      COUNT(*) AS a_4
    FROM
      (
        SELECT
          MultipleColumns.int_a AS a_1
        FROM
          MultipleColumns
      ) AS multiplecolumns_2
    GROUP BY 1
  ) AS aggregatescan_5
ORDER BY aggregatescan_5.a_3;
==

# GROUPING() can reference a column grouped via ** inside ROLLUP.
SELECT GROUPING(int_a) AS g, COUNT(*) AS n
FROM MultipleColumns
GROUP BY ROLLUP(**COLUMNS(['int_a', 'string_a']))
--
QueryStmt
+-output_column_list=
| +-$grouping_call.$grouping_call1#11 AS g [INT64]
| +-$aggregate.n#8 AS n [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$grouping_call.$grouping_call1#11, $aggregate.n#8]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$groupby.int_a#9, $aggregate.n#8, $grouping_call.$grouping_call1#11]
        +-input_scan=
        | +-TableScan(column_list=MultipleColumns.[int_a#1, string_a#2], table=MultipleColumns, column_index_list=[0, 1])
        +-group_by_list=
        | +-int_a#9 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        | +-string_a#10 := ColumnRef(type=STRING, column=MultipleColumns.string_a#2)
        +-aggregate_list=
        | +-n#8 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
        +-grouping_set_list=
        | +-Rollup
        |   +-rollup_column_list=
        |     +-GroupingSetMultiColumn
        |     | +-column_list=
        |     |   +-ColumnRef(type=INT64, column=$groupby.int_a#9)
        |     +-GroupingSetMultiColumn
        |       +-column_list=
        |         +-ColumnRef(type=STRING, column=$groupby.string_a#10)
        +-grouping_call_list=
          +-GroupingCall
            +-group_by_column=
            | +-ColumnRef(type=INT64, column=$groupby.int_a#9)
            +-output_column=$grouping_call.$grouping_call1#11

[SQLBUILDER_OUTPUT]
SELECT
  aggregatescan_7.a_6 AS g,
  aggregatescan_7.a_5 AS n
FROM
  (
    SELECT
      multiplecolumns_3.a_1 AS a_4,
      COUNT(*) AS a_5,
      `GROUPING`(multiplecolumns_3.a_1) AS a_6
    FROM
      (
        SELECT
          MultipleColumns.int_a AS a_1,
          MultipleColumns.string_a AS a_2
        FROM
          MultipleColumns
      ) AS multiplecolumns_3
    GROUP BY ROLLUP(1, multiplecolumns_3.a_2)
  ) AS aggregatescan_7;
==

# GROUP BY ALL infers the grouping columns from a ** in the SELECT list.
SELECT **COLUMNS(['int_a']), COUNT(*) AS n
FROM MultipleColumns
GROUP BY ALL
--
QueryStmt
+-output_column_list=
| +-$groupby.int_a#8 AS int_a [INT64]
| +-$aggregate.n#7 AS n [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$groupby.int_a#8, $aggregate.n#7]
    +-input_scan=
      +-AggregateScan
        +-column_list=[$groupby.int_a#8, $aggregate.n#7]
        +-input_scan=
        | +-TableScan(column_list=[MultipleColumns.int_a#1], table=MultipleColumns, column_index_list=[0])
        +-group_by_list=
        | +-int_a#8 := ColumnRef(type=INT64, column=MultipleColumns.int_a#1)
        +-aggregate_list=
          +-n#7 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  multiplecolumns_2.a_1 AS int_a,
  COUNT(*) AS n
FROM
  (
    SELECT
      MultipleColumns.int_a AS a_1
    FROM
      MultipleColumns
  ) AS multiplecolumns_2
GROUP BY ALL;
==

################################################################################
#
# Negative cases
#
################################################################################

# ------------------------------------------------------------------------------
# Constructs that require at least one column
# ------------------------------------------------------------------------------

# ROLLUP and CUBE require at least one column, which an empty expansion cannot
# satisfy, however it is parenthesized.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY {{ROLLUP|CUBE}}({{**COLUMNS([])|(**COLUMNS([]))|**(COLUMNS([]))}})
--
ALTERNATION GROUP: ROLLUP,**COLUMNS([])
--
ERROR: ROLLUP must have at least one column [at 3:10]
GROUP BY ROLLUP(**COLUMNS([]))
         ^
--
ALTERNATION GROUP: ROLLUP,(**COLUMNS([]))
--
ERROR: ROLLUP must have at least one column [at 3:10]
GROUP BY ROLLUP((**COLUMNS([])))
         ^
--
ALTERNATION GROUP: ROLLUP,**(COLUMNS([]))
--
ERROR: ROLLUP must have at least one column [at 3:10]
GROUP BY ROLLUP(**(COLUMNS([])))
         ^
--
ALTERNATION GROUP: CUBE,**COLUMNS([])
--
ERROR: CUBE must have at least one column [at 3:10]
GROUP BY CUBE(**COLUMNS([]))
         ^
--
ALTERNATION GROUP: CUBE,(**COLUMNS([]))
--
ERROR: CUBE must have at least one column [at 3:10]
GROUP BY CUBE((**COLUMNS([])))
         ^
--
ALTERNATION GROUP: CUBE,**(COLUMNS([]))
--
ERROR: CUBE must have at least one column [at 3:10]
GROUP BY CUBE(**(COLUMNS([])))
         ^
==

# An empty parenthesized expansion is dropped rather than kept as an empty ()
# element, even when repeated.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY {{ROLLUP|CUBE}}(
  {{**COLUMNS([]), **COLUMNS([])|(**COLUMNS([])), (**COLUMNS([]))}})
--
ALTERNATION GROUPS:
    ROLLUP,**COLUMNS([]), **COLUMNS([])
    ROLLUP,(**COLUMNS([])), (**COLUMNS([]))
--
ERROR: ROLLUP must have at least one column [at 3:10]
GROUP BY ROLLUP(
         ^
--
ALTERNATION GROUPS:
    CUBE,**COLUMNS([]), **COLUMNS([])
    CUBE,(**COLUMNS([])), (**COLUMNS([]))
--
ERROR: CUBE must have at least one column [at 3:10]
GROUP BY CUBE(
         ^
==

# The empty expansion check applies to each ROLLUP or CUBE on its own, even when
# other grouping items in the same GROUP BY do have columns.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY ROLLUP(int_a), {{ROLLUP|CUBE}}(**COLUMNS([]))
--
ALTERNATION GROUP: ROLLUP
--
ERROR: ROLLUP must have at least one column [at 3:25]
GROUP BY ROLLUP(int_a), ROLLUP(**COLUMNS([]))
                        ^
--
ALTERNATION GROUP: CUBE
--
ERROR: CUBE must have at least one column [at 3:25]
GROUP BY ROLLUP(int_a), CUBE(**COLUMNS([]))
                        ^
==

# The same applies to ROLLUP and CUBE nested inside GROUPING SETS.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY GROUPING SETS({{ROLLUP|CUBE}}((**COLUMNS([]))), int_b)
--
ALTERNATION GROUP: ROLLUP
--
ERROR: ROLLUP must have at least one column [at 3:24]
GROUP BY GROUPING SETS(ROLLUP((**COLUMNS([]))), int_b)
                       ^
--
ALTERNATION GROUP: CUBE
--
ERROR: CUBE must have at least one column [at 3:24]
GROUP BY GROUPING SETS(CUBE((**COLUMNS([]))), int_b)
                       ^
==

# GROUPING SETS requires at least one set, which an empty expansion cannot
# satisfy.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY GROUPING SETS(**COLUMNS([]))
--
ERROR: GROUPING SETS must have at least one column [at 3:10]
GROUP BY GROUPING SETS(**COLUMNS([]))
         ^
==

# ------------------------------------------------------------------------------
# Aliasing
# ------------------------------------------------------------------------------

# An alias cannot be attached to ** in GROUP BY; the parser rejects it.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['int_a', 'string_a']) as a
--
ERROR: Syntax error: Expected end of input but got keyword AS [at 3:43]
GROUP BY **COLUMNS(['int_a', 'string_a']) as a
                                          ^
==

# An alias cannot be attached to ** in the SELECT list either.
SELECT **COLUMNS(['int_a']) as a, COUNT(*)
FROM MultipleColumns
GROUP BY a, **COLUMNS(['string_a']);

--
ERROR: ** expression cannot be aliased [at 1:29]
SELECT **COLUMNS(['int_a']) as a, COUNT(*)
                            ^
==

# ------------------------------------------------------------------------------
# Columns that cannot be grouped
# ------------------------------------------------------------------------------

# A ** in the SELECT list cannot expand to a column that is neither grouped nor
# aggregated.
SELECT **COLUMNS(['int_b']), COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['int_a', 'string_a']);

--
ERROR: SELECT list expression references column int_b which is neither grouped nor aggregated [at 1:8]
SELECT **COLUMNS(['int_b']), COUNT(*)
       ^
==

# A column of an ungroupable type is rejected the same way as when it is listed
# explicitly.
SELECT COUNT(*)
FROM ComplexTypes
GROUP BY **COLUMNS(['KitchenSink'])
--
ERROR: Grouping by expressions of type PROTO is not allowed [at 3:12]
GROUP BY **COLUMNS(['KitchenSink'])
           ^
==

# ------------------------------------------------------------------------------
# Name resolution
# ------------------------------------------------------------------------------

# A name in the column list that matches no column is an error.
SELECT COUNT(*)
FROM MultipleColumns
GROUP BY **COLUMNS(['bogus'])
--
ERROR: Name bogus not found in the current scope [at 3:12]
GROUP BY **COLUMNS(['bogus'])
           ^
