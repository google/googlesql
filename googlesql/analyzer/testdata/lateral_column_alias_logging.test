    |                 |   | |     | |   +-expr=
    |                 |   | |     | |   | +-ColumnRef(type=STRUCT<x INT64, y INT64>, column=outer_t.s#1, is_correlated=TRUE)
    |                 |   | |     | |   +-field_idx=0
    |                 |   | |     | +-FunctionCall(GoogleSQL:rand() -> DOUBLE)
