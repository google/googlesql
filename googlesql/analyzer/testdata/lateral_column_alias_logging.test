# A pipe DROP of a name that isn't in the input table, but is the name of a
# SELECT-list alias.
# TODO: b/578952682 - The alias shouldn't change the error, but the error says
# the name is present.
[language_features=MAXIMUM,+PIPES]
SELECT 1 AS dd, (FROM KeyValue |> DROP dd |> SELECT COUNT(*)) AS c
FROM (SELECT 1 AS x)
--
ERROR: Name in pipe DROP is present but is not a column on the pipe input table; DROP can only drop columns: dd [at 1:40]
SELECT 1 AS dd, (FROM KeyValue |> DROP dd |> SELECT COUNT(*)) AS c
                                       ^
