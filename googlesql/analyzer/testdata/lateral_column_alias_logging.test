# Dot-star of an outer range variable, when a SELECT-list alias has the same
# name. With the feature, the alias is expanded instead.
# TODO: b/578952682 - Without the feature, the range variable should be expanded
# the same way as without the alias, but it's expanded as a STRUCT value.
[language_features=MAXIMUM,{{-|+}}LATERAL_COLUMN_REFERENCES]
SELECT
  (
    SELECT AS STRUCT 1 AS o, (SELECT AS STRUCT o.*) AS inner_s
    FROM (SELECT 1)
  ) AS s
FROM (SELECT 1 AS x, 2 AS y) AS o
--
ALTERNATION GROUP: -
--
