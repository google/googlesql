# Regression test for b/477296061.
SELECT
  (
    SELECT AS STRUCT
      2 AS d,
      (SELECT d)
  )
FROM (SELECT 1 AS d)
--
QueryStmt
+-output_column_list=
| +-$query.$col1#6 AS `$col1` [STRUCT<d INT64, INT64>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#6]
    +-expr_list=
    | +-$col1#6 :=
    |   +-SubqueryExpr
    |     +-type=STRUCT<d INT64, INT64>
    |     +-subquery_type=SCALAR
    |     +-parameter_list=
    |     | +-ColumnRef(type=INT64, column=$subquery1.d#1)
    |     +-subquery=
    |       +-ProjectScan
    |         +-column_list=[$make_struct.$struct#5]
    |         +-expr_list=
    |         | +-$struct#5 :=
    |         |   +-MakeStruct
    |         |     +-type=STRUCT<d INT64, INT64>
    |         |     +-field_list=
    |         |       +-ColumnRef(type=INT64, column=$expr_subquery.d#3)
    |         |       +-ColumnRef(type=INT64, column=$expr_subquery.$col2#4)
    |         +-input_scan=
    |           +-ProjectScan
    |             +-column_list=$expr_subquery.[d#3, $col2#4]
    |             +-expr_list=
    |             | +-d#3 := Literal(type=INT64, value=2)
    |             | +-$col2#4 :=
    |             |   +-SubqueryExpr
    |             |     +-type=INT64
    |             |     +-subquery_type=SCALAR
    |             |     +-parameter_list=
    |             |     | +-ColumnRef(type=INT64, column=$subquery1.d#1, is_correlated=TRUE)
    |             |     +-subquery=
    |             |       +-ProjectScan
    |             |         +-column_list=[$expr_subquery.d#2]
    |             |         +-expr_list=
    |             |         | +-d#2 := ColumnRef(type=INT64, column=$subquery1.d#1, is_correlated=TRUE)
    |             |         +-input_scan=
    |             |           +-SingleRowScan
