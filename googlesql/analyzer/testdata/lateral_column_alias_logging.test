    +-column_list=[$query.s#12]
    +-expr_list=
    | +-s#12 :=
    |   +-SubqueryExpr
    |     +-type=STRUCT<o INT64, inner_s STRUCT<x INT64, y INT64>>
    |     +-subquery_type=SCALAR
    |     +-parameter_list=
    |     | +-ColumnRef(type=INT64, column=o.x#1)
    |     | +-ColumnRef(type=INT64, column=o.y#2)
    |     +-subquery=
    |       +-ProjectScan
    |         +-column_list=[$make_struct.$struct#11]
    |         +-expr_list=
    |         | +-$struct#11 :=
    |         |   +-MakeStruct
    |         |     +-type=STRUCT<o INT64, inner_s STRUCT<x INT64, y INT64>>
    |         |     +-field_list=
    |         |       +-ColumnRef(type=INT64, column=$expr_subquery.o#9)
    |         |       +-ColumnRef(type=STRUCT<x INT64, y INT64>, column=$expr_subquery.inner_s#10)
    |         +-input_scan=
    |           +-ProjectScan
    |             +-column_list=$expr_subquery.[o#9, inner_s#10]
    |             +-expr_list=
    |             | +-o#9 := Literal(type=INT64, value=1)
    |             | +-inner_s#10 :=
    |             |   +-SubqueryExpr
    |             |     +-type=STRUCT<x INT64, y INT64>
    |             |     +-subquery_type=SCALAR
    |             |     +-parameter_list=
    |             |     | +-ColumnRef(type=INT64, column=o.x#1, is_correlated=TRUE)
    |             |     | +-ColumnRef(type=INT64, column=o.y#2, is_correlated=TRUE)
    |             |     +-subquery=
    |             |       +-ProjectScan
    |             |         +-column_list=[$make_struct.$struct#8]
    |             |         +-expr_list=
    |             |         | +-$struct#8 :=
    |             |         |   +-MakeStruct
    |             |         |     +-type=STRUCT<x INT64, y INT64>
    |             |         |     +-field_list=
    |             |         |       +-ColumnRef(type=INT64, column=$expr_subquery.x#6)
    |             |         |       +-ColumnRef(type=INT64, column=$expr_subquery.y#7)
    |             |         +-input_scan=
    |             |           +-ProjectScan
    |             |             +-column_list=$expr_subquery.[x#6, y#7]
    |             |             +-expr_list=
    |             |             | +-x#6 :=
    |             |             | | +-GetStructField
    |             |             | |   +-type=INT64
    |             |             | |   +-expr=
    |             |             | |   | +-ColumnRef(type=STRUCT<x INT64, y INT64>, column=$preproject.$struct#5)
    |             |             | |   +-field_idx=0
    |             |             | +-y#7 :=
    |             |             |   +-GetStructField
    |             |             |     +-type=INT64
    |             |             |     +-expr=
    |             |             |     | +-ColumnRef(type=STRUCT<x INT64, y INT64>, column=$preproject.$struct#5)
    |             |             |     +-field_idx=1
    |             |             +-input_scan=
    |             |               +-ProjectScan
    |             |                 +-column_list=[$preproject.$struct#5]
    |             |                 +-expr_list=
