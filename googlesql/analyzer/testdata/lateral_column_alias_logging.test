    |                 |       | +-$struct#7 := ColumnRef(type=STRUCT<a INT64, b INT64>, column=outer_t.s2#2, is_correlated=TRUE)
    |                 |       +-input_scan=
    |                 |         +-FilterScan
    |                 |           +-column_list=inner_t.[x#3, y#4]
    |                 |           +-input_scan=
    |                 |           | +-ProjectScan
    |                 |           |   +-column_list=inner_t.[x#3, y#4]
    |                 |           |   +-expr_list=
    |                 |           |   | +-x#3 := Literal(type=INT64, value=1)
    |                 |           |   | +-y#4 := Literal(type=INT64, value=2)
    |                 |           |   +-input_scan=
    |                 |           |     +-SingleRowScan
    |                 |           +-filter_expr=
