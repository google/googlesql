[default language_features=MAXIMUM,+COLUMN_LIST_SPEC,+COLLATION_SUPPORT,+ANNOTATION_FRAMEWORK]
[default show_sqlbuilder_output]
[default use_constant_evaluator]
[default sql_builder_target_syntax_mode=standard]

# Tests for UNPACK (**) expressions in GQL ORDER BY and GROUP BY.
#
# ** reaches shared ORDER BY / GROUP BY resolution from three GQL callers:
# RETURN ... ORDER BY, the standalone ORDER BY statement, and WITH / RETURN
# ... GROUP BY. Each caller has its own cases; variants that resolve
# identically are alternations on one case.

################################################################################
#
# Positive cases
#
################################################################################

# ------------------------------------------------------------------------------
# RETURN ... ORDER BY
# ------------------------------------------------------------------------------

# ** expands in place into one ORDER BY item per column, keeping its position
# relative to explicit items, and may order by the same column more than once.
select * from graph_table(
  aml
  match (a)
  return a.id, a.age
  order by **COLUMNS(['id']), age, **COLUMNS(['id', 'age'])
)
--
QueryStmt
+-output_column_list=
| +-$graph_table.id#2 AS id [INT64]
| +-$graph_table.age#3 AS age [UINT32]
+-query=
  +-ProjectScan
    +-column_list=$graph_table.[id#2, age#3]
    +-input_scan=
      +-GraphTableScan
        +-column_list=$graph_table.[id#2, age#3]
        +-property_graph=aml
        +-input_scan=
          +-GraphLinearScan
            +-column_list=$graph_table.[id#2, age#3]
            +-scan_list=
              +-GraphLinearScan
                +-column_list=$graph_table.[id#2, age#3]
                +-scan_list=
                  +-GraphScan
                  | +-column_list=[$element_table.a#1]
                  | +-input_scan_list=
                  | | +-GraphPathScan
                  | |   +-column_list=[$element_table.a#1]
                  | |   +-input_scan_list=
                  | |   | +-GraphNodeScan
                  | |   |   +-column_list=[$element_table.a#1]
                  | |   |   +-label_expr=
                  | |   |   | +-GraphLabelNaryExpr
                  | |   |   |   +-op=OR
                  | |   |   |   +-operand_list=
                  | |   |   |     +-GraphWildCardLabel
                  | |   |   |     +-GraphLabelNaryExpr
                  | |   |   |       +-op=NOT
                  | |   |   |       +-operand_list=
                  | |   |   |         +-GraphWildCardLabel
                  | |   |   +-target_element_table_list=[aml.Account,aml.Person,aml.Syndicate]
                  | |   +-head=$element_table.a#1
                  | |   +-tail=$element_table.a#1
                  | +-input_scan=
                  |   +-SingleRowScan
                  +-OrderByScan
                    +-column_list=$graph_table.[id#2, age#3]
                    +-is_ordered=TRUE
                    +-input_scan=
                    | +-ProjectScan
                    |   +-column_list=[$element_table.a#1, $graph_table.id#2, $graph_table.age#3]
                    |   +-expr_list=
                    |   | +-id#2 :=
                    |   | | +-GraphGetElementProperty
                    |   | |   +-type=INT64
                    |   | |   +-expr=
                    |   | |   | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                    |   | |   +-property=id(INT64)
                    |   | |   +-property_name=
                    |   | |     +-Literal(type=STRING, value="id", has_explicit_type=TRUE)
                    |   | +-age#3 :=
                    |   |   +-GraphGetElementProperty
                    |   |     +-type=UINT32
                    |   |     +-expr=
                    |   |     | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                    |   |     +-property=age(UINT32)
                    |   |     +-property_name=
                    |   |       +-Literal(type=STRING, value="age", has_explicit_type=TRUE)
                    |   +-input_scan=
                    |     +-GraphRefScan(column_list=[$element_table.a#1])
                    +-order_by_item_list=
                      +-OrderByItem
                      | +-column_ref=
                      |   +-ColumnRef(type=INT64, column=$graph_table.id#2)
                      +-OrderByItem
                      | +-column_ref=
                      |   +-ColumnRef(type=UINT32, column=$graph_table.age#3)
                      +-OrderByItem
                      | +-column_ref=
                      |   +-ColumnRef(type=INT64, column=$graph_table.id#2)
                      +-OrderByItem
                        +-column_ref=
                          +-ColumnRef(type=UINT32, column=$graph_table.age#3)

[SQLBUILDER_OUTPUT]
SELECT
  aml_1.a_3 AS id,
  aml_1.a_4 AS age
FROM
  GRAPH_TABLE(
    aml
    MATCH
      (a_2 IS (% | ! %))
    RETURN
      a_2.id AS a_3,
      a_2.age AS a_4
    ORDER BY a_3, a_4
  ) AS aml_1;
==

# Ordering modifiers (ASC/DESC, NULLS FIRST/LAST, COLLATE) apply to every column
# the expansion produces, and each item keeps its own modifiers.
select * from graph_table(
  aml
  match (a)
  return a.name, a.id
  order by **COLUMNS(['name']) COLLATE 'unicode:ci' DESC NULLS LAST,
           **COLUMNS(['id']) NULLS FIRST
)
--
QueryStmt
+-output_column_list=
| +-$graph_table.name#2 AS name [STRING]
| +-$graph_table.id#3 AS id [INT64]
+-query=
  +-ProjectScan
    +-column_list=$graph_table.[name#2, id#3]
    +-input_scan=
      +-GraphTableScan
        +-column_list=$graph_table.[name#2, id#3]
        +-property_graph=aml
        +-input_scan=
          +-GraphLinearScan
            +-column_list=$graph_table.[name#2, id#3]
            +-scan_list=
              +-GraphLinearScan
                +-column_list=$graph_table.[name#2, id#3]
                +-scan_list=
                  +-GraphScan
                  | +-column_list=[$element_table.a#1]
                  | +-input_scan_list=
                  | | +-GraphPathScan
                  | |   +-column_list=[$element_table.a#1]
                  | |   +-input_scan_list=
                  | |   | +-GraphNodeScan
                  | |   |   +-column_list=[$element_table.a#1]
                  | |   |   +-label_expr=
                  | |   |   | +-GraphLabelNaryExpr
                  | |   |   |   +-op=OR
                  | |   |   |   +-operand_list=
                  | |   |   |     +-GraphWildCardLabel
                  | |   |   |     +-GraphLabelNaryExpr
                  | |   |   |       +-op=NOT
                  | |   |   |       +-operand_list=
                  | |   |   |         +-GraphWildCardLabel
                  | |   |   +-target_element_table_list=[aml.Account,aml.Person,aml.Syndicate]
                  | |   +-head=$element_table.a#1
                  | |   +-tail=$element_table.a#1
                  | +-input_scan=
                  |   +-SingleRowScan
                  +-OrderByScan
                    +-column_list=$graph_table.[name#2, id#3]
                    +-is_ordered=TRUE
                    +-input_scan=
                    | +-ProjectScan
                    |   +-column_list=[$element_table.a#1, $graph_table.name#2, $graph_table.id#3]
                    |   +-expr_list=
                    |   | +-name#2 :=
                    |   | | +-GraphGetElementProperty
                    |   | |   +-type=STRING
                    |   | |   +-expr=
                    |   | |   | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                    |   | |   +-property=name(STRING)
                    |   | |   +-property_name=
                    |   | |     +-Literal(type=STRING, value="name", has_explicit_type=TRUE)
                    |   | +-id#3 :=
                    |   |   +-GraphGetElementProperty
                    |   |     +-type=INT64
                    |   |     +-expr=
                    |   |     | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                    |   |     +-property=id(INT64)
                    |   |     +-property_name=
                    |   |       +-Literal(type=STRING, value="id", has_explicit_type=TRUE)
                    |   +-input_scan=
                    |     +-GraphRefScan(column_list=[$element_table.a#1])
                    +-order_by_item_list=
                      +-OrderByItem
                      | +-column_ref=
                      | | +-ColumnRef(type=STRING, column=$graph_table.name#2)
                      | +-collation_name=
                      | | +-Literal(type=STRING, value="unicode:ci")
                      | +-is_descending=TRUE
                      | +-null_order=NULLS_LAST
                      | +-collation=unicode:ci
                      +-OrderByItem
                        +-column_ref=
                        | +-ColumnRef(type=INT64, column=$graph_table.id#3)
                        +-null_order=NULLS_FIRST

[SQLBUILDER_OUTPUT]
SELECT
  aml_1.a_3 AS name,
  aml_1.a_4 AS id
FROM
  GRAPH_TABLE(
    aml
    MATCH
      (a_2 IS (% | ! %))
    RETURN
      a_2.name AS a_3,
      a_2.id AS a_4
    ORDER BY a_3 COLLATE "unicode:ci" DESC NULLS LAST, a_4 NULLS FIRST
  ) AS aml_1;
==

# An empty expansion produces no ORDER BY items, so no OrderByScan is created;
# a ProjectScan still narrows the output to the RETURN columns. Modifiers on
# such an ORDER BY have nothing to apply to.
select * from graph_table(
  aml
  match (a)
  return a.id, a.age
  order by **COLUMNS([]){{| DESC}}
)
--
QueryStmt
+-output_column_list=
| +-$graph_table.id#2 AS id [INT64]
| +-$graph_table.age#3 AS age [UINT32]
+-query=
  +-ProjectScan
    +-column_list=$graph_table.[id#2, age#3]
    +-input_scan=
      +-GraphTableScan
        +-column_list=$graph_table.[id#2, age#3]
        +-property_graph=aml
        +-input_scan=
          +-GraphLinearScan
            +-column_list=$graph_table.[id#2, age#3]
            +-scan_list=
              +-GraphLinearScan
                +-column_list=$graph_table.[id#2, age#3]
                +-scan_list=
                  +-GraphScan
                  | +-column_list=[$element_table.a#1]
                  | +-input_scan_list=
                  | | +-GraphPathScan
                  | |   +-column_list=[$element_table.a#1]
                  | |   +-input_scan_list=
                  | |   | +-GraphNodeScan
                  | |   |   +-column_list=[$element_table.a#1]
                  | |   |   +-label_expr=
                  | |   |   | +-GraphLabelNaryExpr
                  | |   |   |   +-op=OR
                  | |   |   |   +-operand_list=
                  | |   |   |     +-GraphWildCardLabel
                  | |   |   |     +-GraphLabelNaryExpr
                  | |   |   |       +-op=NOT
                  | |   |   |       +-operand_list=
                  | |   |   |         +-GraphWildCardLabel
                  | |   |   +-target_element_table_list=[aml.Account,aml.Person,aml.Syndicate]
                  | |   +-head=$element_table.a#1
                  | |   +-tail=$element_table.a#1
                  | +-input_scan=
                  |   +-SingleRowScan
                  +-ProjectScan
                    +-column_list=$graph_table.[id#2, age#3]
                    +-input_scan=
                      +-ProjectScan
                        +-column_list=[$element_table.a#1, $graph_table.id#2, $graph_table.age#3]
                        +-expr_list=
                        | +-id#2 :=
                        | | +-GraphGetElementProperty
                        | |   +-type=INT64
                        | |   +-expr=
                        | |   | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                        | |   +-property=id(INT64)
                        | |   +-property_name=
                        | |     +-Literal(type=STRING, value="id", has_explicit_type=TRUE)
                        | +-age#3 :=
                        |   +-GraphGetElementProperty
                        |     +-type=UINT32
                        |     +-expr=
                        |     | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                        |     +-property=age(UINT32)
                        |     +-property_name=
                        |       +-Literal(type=STRING, value="age", has_explicit_type=TRUE)
                        +-input_scan=
                          +-GraphRefScan(column_list=[$element_table.a#1])

[SQLBUILDER_OUTPUT]
SELECT
  aml_1.a_3 AS id,
  aml_1.a_4 AS age
FROM
  GRAPH_TABLE(
    aml
    MATCH
      (a_2 IS (% | ! %))
    RETURN
      a_2.id AS a_3,
      a_2.age AS a_4
  ) AS aml_1;
==

# Likewise, a hint on an ORDER BY whose only item expands to nothing has no
# OrderByScan to attach to and is dropped.
select * from graph_table(
  aml
  match (a)
  return a.id, a.age
  order @{key=1} by **COLUMNS([])
)
--
