==

# ------------------------------------------------------------------------------
# Standalone ORDER BY
# ------------------------------------------------------------------------------

# The standalone ORDER BY statement expands ** against the preceding WITH
# columns, with per-item modifiers.
select * from graph_table(
  aml
  match (a)
  with a.id as id, a.age as age
  order by **COLUMNS(['id']) DESC, **COLUMNS(['age'])
  return id, age
)
--
QueryStmt
+-output_column_list=
| +-$graph_table.id#4 AS id [INT64]
| +-$graph_table.age#5 AS age [UINT32]
+-query=
  +-ProjectScan
    +-column_list=$graph_table.[id#4, age#5]
    +-input_scan=
      +-GraphTableScan
        +-column_list=$graph_table.[id#4, age#5]
        +-property_graph=aml
        +-input_scan=
          +-GraphLinearScan
            +-column_list=$graph_table.[id#4, age#5]
            +-scan_list=
              +-GraphLinearScan
                +-column_list=$graph_table.[id#4, age#5]
                +-scan_list=
                  +-GraphScan
                  | +-column_list=[$element_table.a#1]
                  | +-input_scan_list=
                  | | +-GraphPathScan
                  | |   +-column_list=[$element_table.a#1]
                  | |   +-input_scan_list=
                  | |   | +-GraphNodeScan
                  | |   |   +-column_list=[$element_table.a#1]
                  | |   |   +-label_expr=
                  | |   |   | +-GraphLabelNaryExpr
                  | |   |   |   +-op=OR
                  | |   |   |   +-operand_list=
                  | |   |   |     +-GraphWildCardLabel
                  | |   |   |     +-GraphLabelNaryExpr
                  | |   |   |       +-op=NOT
                  | |   |   |       +-operand_list=
                  | |   |   |         +-GraphWildCardLabel
                  | |   |   +-target_element_table_list=[aml.Account,aml.Person,aml.Syndicate]
                  | |   +-head=$element_table.a#1
                  | |   +-tail=$element_table.a#1
                  | +-input_scan=
                  |   +-SingleRowScan
                  +-ProjectScan
                  | +-column_list=$graph_table.[id#2, age#3]
                  | +-expr_list=
                  | | +-id#2 :=
                  | | | +-GraphGetElementProperty
                  | | |   +-type=INT64
                  | | |   +-expr=
                  | | |   | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                  | | |   +-property=id(INT64)
                  | | |   +-property_name=
                  | | |     +-Literal(type=STRING, value="id", has_explicit_type=TRUE)
                  | | +-age#3 :=
                  | |   +-GraphGetElementProperty
                  | |     +-type=UINT32
                  | |     +-expr=
                  | |     | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                  | |     +-property=age(UINT32)
                  | |     +-property_name=
                  | |       +-Literal(type=STRING, value="age", has_explicit_type=TRUE)
                  | +-input_scan=
                  |   +-GraphRefScan(column_list=[$element_table.a#1])
                  +-OrderByScan
                  | +-column_list=$graph_table.[id#2, age#3]
                  | +-is_ordered=TRUE
                  | +-input_scan=
                  | | +-GraphRefScan(column_list=$graph_table.[id#2, age#3])
                  | +-order_by_item_list=
                  |   +-OrderByItem
                  |   | +-column_ref=
                  |   | | +-ColumnRef(type=INT64, column=$graph_table.id#2)
                  |   | +-is_descending=TRUE
                  |   +-OrderByItem
                  |     +-column_ref=
                  |       +-ColumnRef(type=UINT32, column=$graph_table.age#3)
                  +-ProjectScan
                    +-column_list=$graph_table.[id#4, age#5]
                    +-expr_list=
                    | +-id#4 := ColumnRef(type=INT64, column=$graph_table.id#2)
                    | +-age#5 := ColumnRef(type=UINT32, column=$graph_table.age#3)
                    +-input_scan=
                      +-GraphRefScan(column_list=$graph_table.[id#2, age#3])

[SQLBUILDER_OUTPUT]
SELECT
  aml_1.a_5 AS id,
  aml_1.a_6 AS age
FROM
  GRAPH_TABLE(
    aml
    MATCH
      (a_2 IS (% | ! %))
    WITH
      a_2.id AS a_3,
