# ------------------------------------------------------------------------------
# RETURN ... GROUP BY
# ------------------------------------------------------------------------------

# ** expands in place into grouping columns, resolved against the RETURN
# aliases. A column grouped both explicitly and through an expansion, or
# through two expansions, is grouped once. ORDER BY after GROUP BY resolves **
# in the post-grouping scope.
#
# TODO: b/580835510 - The SQLBuilder output lists the ORDER BY items in column
# id order (c before age) rather than query order. The alternation shows the
# output is the same for an explicit column, so this is unrelated to **.
select * from graph_table(
  aml
  match (a)
  return a.id as id, a.age as age, count(*) as c
  group by id, **COLUMNS(['age']), **COLUMNS(['id'])
  order by {{**COLUMNS(['age'])|age}}, c
)
--
QueryStmt
+-output_column_list=
| +-$graph_table.id#5 AS id [INT64]
| +-$graph_table.age#6 AS age [UINT32]
| +-$graph_table.c#2 AS c [INT64]
+-query=
  +-ProjectScan
    +-column_list=$graph_table.[id#5, age#6, c#2]
    +-input_scan=
      +-GraphTableScan
        +-column_list=$graph_table.[id#5, age#6, c#2]
        +-property_graph=aml
        +-input_scan=
          +-GraphLinearScan
            +-column_list=$graph_table.[id#5, age#6, c#2]
            +-scan_list=
              +-GraphLinearScan
                +-column_list=$graph_table.[id#5, age#6, c#2]
                +-scan_list=
                  +-GraphScan
                  | +-column_list=[$element_table.a#1]
                  | +-input_scan_list=
                  | | +-GraphPathScan
                  | |   +-column_list=[$element_table.a#1]
                  | |   +-input_scan_list=
                  | |   | +-GraphNodeScan
                  | |   |   +-column_list=[$element_table.a#1]
                  | |   |   +-label_expr=
                  | |   |   | +-GraphLabelNaryExpr
                  | |   |   |   +-op=OR
                  | |   |   |   +-operand_list=
                  | |   |   |     +-GraphWildCardLabel
                  | |   |   |     +-GraphLabelNaryExpr
                  | |   |   |       +-op=NOT
                  | |   |   |       +-operand_list=
                  | |   |   |         +-GraphWildCardLabel
                  | |   |   +-target_element_table_list=[aml.Account,aml.Person,aml.Syndicate]
                  | |   +-head=$element_table.a#1
                  | |   +-tail=$element_table.a#1
                  | +-input_scan=
                  |   +-SingleRowScan
                  +-OrderByScan
                    +-column_list=$graph_table.[id#5, age#6, c#2]
                    +-is_ordered=TRUE
                    +-input_scan=
                    | +-AggregateScan
                    |   +-column_list=$graph_table.[id#5, age#6, c#2]
                    |   +-input_scan=
                    |   | +-ProjectScan
                    |   |   +-column_list=[$element_table.a#1, $pre_groupby.id#3, $pre_groupby.age#4]
                    |   |   +-expr_list=
                    |   |   | +-id#3 :=
                    |   |   | | +-GraphGetElementProperty
                    |   |   | |   +-type=INT64
                    |   |   | |   +-expr=
                    |   |   | |   | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                    |   |   | |   +-property=id(INT64)
                    |   |   | |   +-property_name=
                    |   |   | |     +-Literal(type=STRING, value="id", has_explicit_type=TRUE)
                    |   |   | +-age#4 :=
                    |   |   |   +-GraphGetElementProperty
                    |   |   |     +-type=UINT32
                    |   |   |     +-expr=
                    |   |   |     | +-ColumnRef(type=GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, data BYTES, id INT64, name STRING, syndicateData ARRAY<INT64>, syndicateId INT64, syndicateName STRING>, column=$element_table.a#1)
                    |   |   |     +-property=age(UINT32)
                    |   |   |     +-property_name=
                    |   |   |       +-Literal(type=STRING, value="age", has_explicit_type=TRUE)
                    |   |   +-input_scan=
                    |   |     +-GraphRefScan(column_list=[$element_table.a#1])
                    |   +-group_by_list=
                    |   | +-id#5 := ColumnRef(type=INT64, column=$pre_groupby.id#3)
                    |   | +-age#6 := ColumnRef(type=UINT32, column=$pre_groupby.age#4)
                    |   +-aggregate_list=
                    |     +-c#2 := AggregateFunctionCall(GoogleSQL:$count_star() -> INT64)
                    +-order_by_item_list=
                      +-OrderByItem
                      | +-column_ref=
                      |   +-ColumnRef(type=UINT32, column=$graph_table.age#6)
                      +-OrderByItem
                        +-column_ref=
                          +-ColumnRef(type=INT64, column=$graph_table.c#2)

[SQLBUILDER_OUTPUT]
SELECT
  aml_1.a_3 AS id,
  aml_1.a_4 AS age,
  aml_1.a_5 AS c
FROM
  GRAPH_TABLE(
    aml
    MATCH
      (a_2 IS (% | ! %))
    RETURN
      a_2.id AS a_3,
      a_2.age AS a_4,
      COUNT(*) AS a_5
    GROUP BY a_3, a_4
    ORDER BY a_5, a_4
  ) AS aml_1;
