  ) AS aml_1;
==

################################################################################
#
# Negative cases
#
################################################################################

# A name in the column list that matches no column is an error, in GROUP BY and
# ORDER BY alike.
select * from graph_table(
  aml
  match (a)
  return a.id as id
  {{group|order}} by **COLUMNS(['bogus'])
)
--
ALTERNATION GROUP: group
--
ERROR: Name bogus not found in the current scope [at 5:14]
  group by **COLUMNS(['bogus'])
             ^
--
ALTERNATION GROUP: order
--
ERROR: Name bogus not found in the current scope [at 5:14]
  order by **COLUMNS(['bogus'])
             ^
==

# A column of an unorderable type is rejected the same way as when it is listed
# explicitly.
select * from graph_table(
  aml
  match (a)
  with a, a.id as id
  order by **COLUMNS(['a'])
  return id
)
--
ERROR: ORDER BY does not support expressions of type GRAPH_NODE(aml)<age UINT32, balance UINT64, birthday DATE, ...> [at 5:12]
  order by **COLUMNS(['a'])
           ^
==

# ** in GQL GROUP BY and ORDER BY requires COLUMN_LIST_SPEC.
[language_features=MAXIMUM,-COLUMN_LIST_SPEC]
select * from graph_table(
  aml
  match (a)
  return a.id as id
  {{group|order}} by **COLUMNS(['id'])
)
--
ALTERNATION GROUP: group
--
ERROR: Unpack expression (**) is not supported [at 5:12]
  group by **COLUMNS(['id'])
           ^
--
ALTERNATION GROUP: order
--
ERROR: Unpack expression (**) is not supported [at 5:12]
  order by **COLUMNS(['id'])
           ^
==

# The same holds for WITH ... GROUP BY and the standalone ORDER BY.
[language_features=MAXIMUM,-COLUMN_LIST_SPEC]
select * from graph_table(
  aml
  match (a)
  with a.id as id
  {{group|order}} by **COLUMNS(['id'])
  return id
)
--
ALTERNATION GROUP: group
--
ERROR: Unpack expression (**) is not supported [at 5:12]
  group by **COLUMNS(['id'])
           ^
--
ALTERNATION GROUP: order
--
ERROR: Unpack expression (**) is not supported [at 5:12]
  order by **COLUMNS(['id'])
           ^
