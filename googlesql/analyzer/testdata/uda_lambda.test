### Shared Database Setup ###

# Shared base tables for the UDAs below.
[default language_features=NONE,+CREATE_AGGREGATE_FUNCTION,+NAMED_ARGUMENTS,+INLINE_LAMBDA_ARGUMENT,+UDF_LAMBDA_ARGUMENTS,+TEMPLATE_FUNCTIONS,+SAFE_FUNCTION_CALL]
[prepare_database=uda_lambda_db]
CREATE TABLE t_items(k STRING, v INT64, arr ARRAY<INT64>);
--
CreateTableStmt
+-name_path=t_items
+-column_definition_list=
  +-ColumnDefinition(name="k", type=STRING, column=t_items.k#1)
  +-ColumnDefinition(name="v", type=INT64, column=t_items.v#2)
  +-ColumnDefinition(name="arr", type=ARRAY<INT64>, column=t_items.arr#3)
==

[prepare_database=uda_lambda_db]
CREATE TABLE t_outer(grp STRING, offset_val INT64);
--
CreateTableStmt
+-name_path=t_outer
+-column_definition_list=
  +-ColumnDefinition(name="grp", type=STRING, column=t_outer.grp#1)
  +-ColumnDefinition(name="offset_val", type=INT64, column=t_outer.offset_val#2)
==

# Pre-aggregate call of a function-typed parameter: SUM(f(v)).
[prepare_database=uda_lambda_db]
CREATE AGGREGATE FUNCTION AggPreMap(
  v INT64, f FUNCTION<INT64 -> INT64> NOT AGGREGATE)
AS (SUM(f(v)));
--
CreateFunctionStmt
+-name_path=AggPreMap
+-return_type=INT64
+-argument_name_list=[v, f]
+-signature=(INT64 v, FUNCTION<INT64->INT64> {is_not_aggregate: true} f) -> INT64
+-is_aggregate=TRUE
+-language="SQL"
+-code="SUM(f(v))"
+-aggregate_expression_list=
| +-$agg1#1 :=
|   +-AggregateFunctionCall(GoogleSQL:sum(INT64) -> INT64)
|     +-FunctionCall(FUNCTION_TYPED_PARAMETER:f(INT64) -> INT64)
|       +-ArgumentRef(parse_location=100-101, type=INT64, name="v", argument_kind=AGGREGATE)
+-function_expression=
  +-ColumnRef(type=INT64, column=$aggregate.$agg1#1)
==

# Post-aggregate call of a function-typed parameter: f(SUM(v)).
[prepare_database=uda_lambda_db]
CREATE AGGREGATE FUNCTION AggPostMap(
  v INT64, f FUNCTION<INT64 -> FLOAT64> NOT AGGREGATE)
AS (f(SUM(v)));
--
CreateFunctionStmt
+-name_path=AggPostMap
+-return_type=DOUBLE
+-argument_name_list=[v, f]
+-signature=(INT64 v, FUNCTION<INT64->DOUBLE> {is_not_aggregate: true} f) -> DOUBLE
+-is_aggregate=TRUE
+-language="SQL"
+-code="f(SUM(v))"
+-aggregate_expression_list=
| +-$agg1#1 :=
|   +-AggregateFunctionCall(GoogleSQL:sum(INT64) -> INT64)
|     +-ArgumentRef(parse_location=103-104, type=INT64, name="v", argument_kind=AGGREGATE)
+-function_expression=
  +-FunctionCall(FUNCTION_TYPED_PARAMETER:f(INT64) -> DOUBLE)
    +-ColumnRef(type=INT64, column=$aggregate.$agg1#1)
==

# SAFE. call before aggregation plus a second lambda after aggregation.
[prepare_database=uda_lambda_db]
CREATE AGGREGATE FUNCTION AggSafePrePost(
  v INT64,
  pre FUNCTION<INT64 -> INT64> NOT AGGREGATE,
  post FUNCTION<INT64 -> INT64> NOT AGGREGATE)
AS (post(SUM(SAFE.pre(v))));
--
CreateFunctionStmt
+-name_path=AggSafePrePost
+-return_type=INT64
+-argument_name_list=[v, pre, post]
+-signature=(INT64 v, FUNCTION<INT64->INT64> {is_not_aggregate: true} pre, FUNCTION<INT64->INT64> {is_not_aggregate: true} post) -> INT64
+-is_aggregate=TRUE
+-language="SQL"
+-code="post(SUM(SAFE.pre(v)))"
+-aggregate_expression_list=
| +-$agg1#1 :=
|   +-AggregateFunctionCall(GoogleSQL:sum(INT64) -> INT64)
|     +-FunctionCall({SAFE_ERROR_MODE} FUNCTION_TYPED_PARAMETER:pre(INT64) -> INT64)
|       +-ArgumentRef(parse_location=168-169, type=INT64, name="v", argument_kind=AGGREGATE)
+-function_expression=
  +-FunctionCall(FUNCTION_TYPED_PARAMETER:post(INT64) -> INT64)
    +-ColumnRef(type=INT64, column=$aggregate.$agg1#1)
==

# Zero-argument and two-argument function-typed parameters.
[prepare_database=uda_lambda_db]
CREATE AGGREGATE FUNCTION AggZeroAndPair(
  v INT64,
  init FUNCTION<() -> INT64> NOT AGGREGATE,
  comb FUNCTION<(INT64, INT64) -> INT64> NOT AGGREGATE)
AS (comb(SUM(v), init()));
--
CreateFunctionStmt
+-name_path=AggZeroAndPair
+-return_type=INT64
+-argument_name_list=[v, init, comb]
+-signature=(INT64 v, FUNCTION<()->INT64> {is_not_aggregate: true} init, FUNCTION<(INT64, INT64)->INT64> {is_not_aggregate: true} comb) -> INT64
+-is_aggregate=TRUE
+-language="SQL"
+-code="comb(SUM(v), init())"
+-aggregate_expression_list=
| +-$agg1#1 :=
|   +-AggregateFunctionCall(GoogleSQL:sum(INT64) -> INT64)
|     +-ArgumentRef(parse_location=166-167, type=INT64, name="v", argument_kind=AGGREGATE)
+-function_expression=
  +-FunctionCall(FUNCTION_TYPED_PARAMETER:comb(INT64, INT64) -> INT64)
    +-ColumnRef(type=INT64, column=$aggregate.$agg1#1)
    +-FunctionCall(FUNCTION_TYPED_PARAMETER:init() -> INT64)
==

# Forwards FUNCTION f to a built-in higher-order function before aggregation.
[prepare_database=uda_lambda_db]
CREATE AGGREGATE FUNCTION AggForwardHof(
  arr ARRAY<INT64>, f FUNCTION<INT64 -> INT64> NOT AGGREGATE)
AS (ARRAY_CONCAT_AGG(ARRAY_TRANSFORM(arr, FUNCTION f)));
--
CreateFunctionStmt
+-name_path=AggForwardHof
+-return_type=ARRAY<INT64>
+-argument_name_list=[arr, f]
+-signature=(ARRAY<INT64> arr, FUNCTION<INT64->INT64> {is_not_aggregate: true} f) -> ARRAY<INT64>
+-is_aggregate=TRUE
+-language="SQL"
+-code="ARRAY_CONCAT_AGG(ARRAY_TRANSFORM(arr, FUNCTION f))"
+-aggregate_expression_list=
| +-$agg1#1 :=
|   +-AggregateFunctionCall(GoogleSQL:array_concat_agg(ARRAY<INT64>) -> ARRAY<INT64>)
|     +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->INT64> transformation) -> ARRAY<INT64>)
|       +-FunctionArgument
|       | +-expr=
|       |   +-ArgumentRef(parse_location=140-143, type=ARRAY<INT64>, name="arr", argument_kind=AGGREGATE)
|       +-FunctionArgument
|         +-function_ref=
|           +-FunctionRef(function=FUNCTION_TYPED_PARAMETER:f, signature=(INT64) -> INT64)
+-function_expression=
  +-ColumnRef(type=ARRAY<INT64>, column=$aggregate.$agg1#1)
==

# Function-typed parameter that the body never references.
[prepare_database=uda_lambda_db]
CREATE AGGREGATE FUNCTION AggUnusedFn(
