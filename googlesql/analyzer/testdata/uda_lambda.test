# Function-typed parameters require FEATURE_UDF_LAMBDA_ARGUMENTS.
[language_features=NONE,+CREATE_AGGREGATE_FUNCTION]
CREATE AGGREGATE FUNCTION NoLambdaFeature(
  val INT64, f FUNCTION<INT64 -> INT64> NOT AGGREGATE)
AS (SUM(f(val)));
--
ERROR: Function-typed arguments in UDFs are not supported [at 2:16]
  val INT64, f FUNCTION<INT64 -> INT64> NOT AGGREGATE)
               ^
==

### Positional, named, and pipe call resolution tests ###

# Calls to SQL UDAs with lambda or FUNCTION reference arguments are not
# implemented yet, for concrete and templated UDAs.
[use_database=uda_lambda_db]
SELECT {{AggPreMap|TemplatedAggMap}}(v, {{x -> x + 1|f => x -> x + 1|f => FUNCTION abs}})
FROM t_items;
--
ALTERNATION GROUP: AggPreMap,x -> x + 1
--
ERROR: Lambda arguments are not implemented for aggregate functions [at 1:21]
SELECT AggPreMap(v, x -> x + 1)
                    ^
--
ALTERNATION GROUP: AggPreMap,f => x -> x + 1
--
ERROR: Lambda arguments are not implemented for aggregate functions [at 1:26]
SELECT AggPreMap(v, f => x -> x + 1)
                         ^
--
ALTERNATION GROUP: AggPreMap,f => FUNCTION abs
--
ERROR: Lambda arguments are not implemented for aggregate functions [at 1:26]
SELECT AggPreMap(v, f => FUNCTION abs)
                         ^
--
ALTERNATION GROUP: TemplatedAggMap,x -> x + 1
--
ERROR: Lambda arguments are not implemented for aggregate functions [at 1:27]
SELECT TemplatedAggMap(v, x -> x + 1)
                          ^
--
ALTERNATION GROUP: TemplatedAggMap,f => x -> x + 1
--
ERROR: Lambda arguments are not implemented for aggregate functions [at 1:32]
SELECT TemplatedAggMap(v, f => x -> x + 1)
                               ^
--
ALTERNATION GROUP: TemplatedAggMap,f => FUNCTION abs
--
ERROR: Lambda arguments are not implemented for aggregate functions [at 1:32]
SELECT TemplatedAggMap(v, f => FUNCTION abs)
                               ^
==

# A FUNCTION reference forwarded from a SQL UDF to a SQL UDA is not implemented
# yet.
[use_database=uda_lambda_db]
CREATE TEMP FUNCTION ForwardToUda(g FUNCTION<INT64 -> INT64>)
AS ((SELECT AggPreMap(v, FUNCTION g) FROM t_items));
--
ERROR: Lambda arguments are not implemented for aggregate functions [at 2:26]
AS ((SELECT AggPreMap(v, FUNCTION g) FROM t_items));
                         ^
