# Subquery name resolution (standard)
SELECT row_number() OVER (PARTITION BY **COLUMNS(['a']))
FROM (SELECT Key AS a, Value AS b FROM KeyValue)
--
QueryStmt
+-output_column_list=
| +-$analytic.$analytic1#4 AS `$col1` [INT64]
+-query=
  +-ProjectScan
    +-column_list=[$analytic.$analytic1#4]
    +-input_scan=
      +-AnalyticScan
        +-column_list=[KeyValue.Key#1, KeyValue.Value#2, $analytic.$analytic1#4]
        +-input_scan=
        | +-ProjectScan
        |   +-column_list=KeyValue.[Key#1, Value#2]
        |   +-input_scan=
        |     +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
        +-function_group_list=
          +-AnalyticFunctionGroup
            +-partition_by=
            | +-WindowPartitioning
            |   +-partition_by_list=
            |     +-ColumnRef(type=INT64, column=KeyValue.Key#1)
            +-analytic_function_list=
              +-$analytic1#4 := AnalyticFunctionCall(GoogleSQL:row_number() -> INT64)

[SQLBUILDER_OUTPUT]
SELECT
  analyticscan_5.a_4 AS a_4
FROM
  (
    SELECT
      projectscan_3.a_1 AS a_1,
      projectscan_3.a_2 AS a_2,
      ROW_NUMBER() OVER (PARTITION BY projectscan_3.a_1) AS a_4
    FROM
      (
        SELECT
          KeyValue.Key AS a_1,
          KeyValue.Value AS a_2
        FROM
          KeyValue
      ) AS projectscan_3
  ) AS analyticscan_5;
==

