[name=tumble_struct_proto_timestamp_val]
WITH TableWithStructAndProto AS (
  SELECT
    1 AS key,
    STRUCT(
      1 AS ambiguous_field,
      'abc' AS other_field,
      NEW googlesql_test.TestHopAndTumblePB(
        100 AS int32_val,
        TO_PROTO(TIMESTAMP '2025-01-01 00:00:00 UTC') AS timestamp_val,
        TIMESTAMP '2025-01-01 00:00:00 UTC' AS annotated_timestamp_val
      ) AS proto_field
    ) AS StructWithProto,
    NEW googlesql_test.TestHopAndTumblePB(
      200 AS int32_val,
      TO_PROTO(TIMESTAMP '2025-01-01 00:00:00 UTC') AS timestamp_val,
      TIMESTAMP '2025-01-01 00:00:00 UTC' AS annotated_timestamp_val
    ) AS ProtoColumn
)
SELECT * FROM tumble(TABLE TableWithStructAndProto, "StructWithProto.proto_field.timestamp_val", INTERVAL 1 DAY);
