                    IntLiteral(2) [94-95] [2]
                  SimpleType [99-105] [string]
                    PathExpression [99-105] [string]
                      Identifier(string) [99-105] [string]
                StringLiteral [108-116] ["/25/08"]
                  StringLiteralComponent("/25/08") [108-116] ["/25/08"]
