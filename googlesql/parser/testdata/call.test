# Error case, without parenthesis.
call myprocedure
--
ERROR: Syntax error: Expected "(" or "." but got end of statement [at 1:17]
call myprocedure
                ^
==

# CALL arguments are expressions, not parameters.
CALL fn(x NOT AGGREGATE)
--
ERROR: Syntax error: Expected ")" but got keyword NOT [at 1:11]
CALL fn(x NOT AGGREGATE)
          ^

==

# CALL statements can have placeholders.
CALL fn({{?|@x}})
--
ALTERNATION GROUP: ?
--
CallStatement [0-10]
  PathExpression [5-7]
    Identifier(fn) [5-7]
  TVFArgument [8-9]
    ParameterExpr(1) [8-9]
--
CALL fn(?)
--
ALTERNATION GROUP: @x
--
CallStatement [0-11]
  PathExpression [5-7]
    Identifier(fn) [5-7]
  TVFArgument [8-10]
    ParameterExpr [8-10]
      Identifier(x) [9-10]
--
CALL fn(@x)
==

# Procedure calls share the TVF argument grammar, so lambda and FUNCTION
# reference arguments parse (the analyzer rejects them).
CALL proc(x -> x + 1, FUNCTION p, f => FUNCTION q)
--
CallStatement [0-50]
  PathExpression [5-9]
    Identifier(proc) [5-9]
  TVFArgument [10-20]
    Lambda [10-20]
      PathExpression [10-11]
        Identifier(x) [10-11]
      BinaryExpression(+) [15-20]
        PathExpression [15-16]
          Identifier(x) [15-16]
        IntLiteral(1) [19-20]
  TVFArgument [22-32]
    FunctionRefArg [22-32]
      PathExpression [31-32]
        Identifier(p) [31-32]
  TVFArgument [34-49]
    NamedArgument [34-49]
      Identifier(f) [34-35]
      FunctionRefArg [39-49]
        PathExpression [48-49]
          Identifier(q) [48-49]
--
CALL proc((x) -> x + 1, FUNCTION p, f  => FUNCTION q)
