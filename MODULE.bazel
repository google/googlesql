""" Workspace for Open Source GoogleSQL library """

module(
    name = "googlesql",
    version = "2026.11.2",
)

GOOGLESQL_JAVA_ARTIFACTS = [
    "com.google.api.grpc:proto-google-common-protos:2.29.0",
    "com.google.code.findbugs:jsr305:3.0.2",
    "com.google.errorprone:error_prone_annotations:2.23.0",
    "com.google.guava:guava:32.1.3-jre",
    "com.google.guava:guava-testlib:32.1.3-jre",
    "io.grpc:grpc-context:1.64.2",
    "io.grpc:grpc-core:1.64.2",
    "io.grpc:grpc-api:1.64.2",
    "io.grpc:grpc-netty:1.64.2",
    "io.grpc:grpc-protobuf-lite:1.64.2",
    "io.grpc:grpc-protobuf:1.64.2",
    "io.grpc:grpc-stub:1.64.2",
    "io.netty:netty-common:4.1.100.Final",
    "io.netty:netty-transport:4.1.100.Final",
    "io.opencensus:opencensus-api:0.31.0",
    "io.opencensus:opencensus-contrib-grpc-metrics:0.31.0",
    "javax.annotation:javax.annotation-api:1.2",
    "joda-time:joda-time:2.10.13",
    "com.google.auto.service:auto-service:1.0-rc2",
    "com.google.code.gson:gson:jar:2.10.1",
    "com.google.protobuf:protobuf-java:3.23.1",
    "com.google.truth:truth:1.1.5",
    "com.google.truth.extensions:truth-proto-extension:1.4.4",
    "junit:junit:4.13.2",
    "com.google.testparameterinjector:test-parameter-injector:1.18",
]

bazel_dep(name = "abseil-cpp", version = "20260817.0", repo_name = "com_google_absl")
bazel_dep(name = "abseil-py", version = "2.1.0", repo_name = "io_abseil_py")
bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1")
bazel_dep(name = "bazel_features", version = "1.51.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "boost.variant", version = "1.89.0")
bazel_dep(name = "boringssl", version = "0.20260413.0")
bazel_dep(name = "c-ares", version = "1.34.9.bcr.1", repo_name = "com_github_cares_cares")
bazel_dep(name = "civetweb", version = "1.16.bcr.4")
bazel_dep(name = "gazelle", version = "0.47.0", repo_name = "bazel_gazelle")
bazel_dep(name = "google_bazel_common", version = "0.0.1")
bazel_dep(name = "google_benchmark", version = "1.9.5", repo_name = "com_github_google_benchmark")
bazel_dep(name = "googleapis", version = "0.0.0-20260929-28769825", repo_name = "com_google_googleapis")
bazel_dep(name = "googleapis-cc", version = "1.1.5")
bazel_dep(name = "googletest", version = "1.18.0", repo_name = "com_google_googletest")
bazel_dep(name = "grpc", version = "1.84.0", repo_name = "com_github_grpc_grpc")
# protobuf 37.0-rc3 split C++ upb reflection headers (def.hpp, message.hpp) out
# of //upb/reflection into //upb/reflection:reflection_cc, whereas grpc 1.84.0
# still depends on @com_google_protobuf//upb/reflection.
single_version_override(
    module_name = "grpc",
    patch_cmds = [
        "sed -i.bak 's|\"@com_google_protobuf//upb/reflection\"|\"@com_google_protobuf//upb/reflection\", \"@com_google_protobuf//upb/reflection:reflection_cc\"|g' BUILD src/core/BUILD test/core/xds/BUILD && rm -f BUILD.bak src/core/BUILD.bak test/core/xds/BUILD.bak",
    ],
    version = "1.84.0",
)
bazel_dep(name = "grpc-java", version = "1.84.0", repo_name = "io_grpc_grpc_java")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1", repo_name = "json")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "37.0-rc3", repo_name = "com_google_protobuf")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1", repo_name = "com_googlesource_code_re2")
bazel_dep(name = "riegeli", version = "0.0.0-20261106-1290c60", repo_name = "com_google_riegeli")
bazel_dep(name = "rules_bison", version = "0.4")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_flex", version = "0.4")
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_m4", version = "0.3")
bazel_dep(name = "rules_nodejs", version = "6.7.7")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "2.4.1")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "toolchains_llvm", version = "1.13.0")

# Java dependencies.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = GOOGLESQL_JAVA_ARTIFACTS,
    generate_compat_repositories = True,
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

# Go dependencies.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_inspirer_textmapper")

# Python dependencies.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    extra_pip_args = [
        "--retries",
        "5",
        "--timeout",
        "60",
    ],
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pypi")

# Dependencies from http_archive
#
# Notes for 'icu': The ICU module obtained from the Bazel Central Registry (BCR) uses a prebuilt ICU
# data file, which is linked as a runfile dependency. This setup prevents
# //googlesql/tools:execute_query target from being executed directly without setting an environment
# variable to point to the data file.
#
# To resolve this, we are instead using http_archive to download the ICU library and applying a
# custom BUILD file. This custom configuration ensures that the ICU data is used as a static library
# (or statically linked), allowing our execute_query binary to run directly without any external
# runtime dependencies.
http_archive_deps = use_extension("@googlesql//bazel:http_archive_deps.bzl", "googlesql_http_archive_deps")
use_repo(
    http_archive_deps,
    "com_google_cc_differential_privacy",
    "com_google_differential_privacy",
    "com_google_farmhash",
    "com_google_file_based_test_driver",
    "icu",
    "mstch",
    "native_utils",
    "org_publicsuffix",
)

# Dev toolchain.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_versions = {
        "": "21.1.0",
        "darwin-x86_64": "19.1.7",
        "darwin-aarch64": "19.1.7",
    },
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)
